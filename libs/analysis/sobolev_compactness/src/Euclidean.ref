\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import Real.Inverse[] \as Inverse;
\import Real.SquareRoot[] \as Root;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import complex.Complex[] \as C;
\import C.Def[] \as D;
\import C.Prop[] \as CL;
\import C.Absolute[] \as Abs;
\import fourier_schwartz.Scalars[] \as Scalars;
\import fourier_schwartz.NaturalPowers[] \as Powers;
\import fourier_schwartz.Euclidean[n := n] \as E;
\import euclidean_sobolev.Euclidean[n := n] \as Sobolev;
\import fourier_l2.Euclidean[n := n] \as Fourier;
\import Fourier.Multiplication[] \as Mult;
\import Fourier.Unitary[] \as U;
\definition Point: \Set := Sobolev.Point;
\import lp_spaces.Euclidean[n := n] \as LE;
\import functional_analysis.Measure[A := Point] \as Measure;
\import Measure.Integral[mu := LE.measure] \as I;
\import I.Scaling[] \as Scaling;
\import Measure.Functions[mu := LE.measure] \as Measurable;
\import Measure.Sigma[] \as Sigma;
\import lp_spaces.On[A := Point, mu := LE.measure] \as L;
\import L.Complex[] \as L2;
\import L.Products[] \as Products;
\import lp_spaces.Powers[].Algebra[] \as PA;
\import LE.Compact[p := PA.two] \as Compact;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Smooth[].Algebra[U := Open.whole] \as Smooth;
\definition Space: \Set := L2.Space;
\import topology.Topology[Carrier := Point] \as Sets;
\import std.Set[].Quotient[A := L2.Representatives, Equivalent := L2.Equivalent] \as Q;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\module Mask(K: \Pow Point, measurable: Measure.Measurable LE.measure.sigma K);
\module Gap(k, q: N.Nat^);
\module Kernel;
\module Support(K: \Pow Point, compact: Sets.IsCompactIn Ambient.topology K);
