\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import boundary_manifolds.Differential[n := n, m := m].Between[M := M, N := N] \as Differential;
\import boundary_manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import boundary_manifolds.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as SourceTangent;
\import boundary_manifolds.Tangent[n := m].On[M := N] \as TargetTangent;
\import topology.Topology[Carrier := M.Point] \as Source;
\import topology.Topology[Carrier := N.Point] \as Target;
\module Of(f: Maps.Map);
