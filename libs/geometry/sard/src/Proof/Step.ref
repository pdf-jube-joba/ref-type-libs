\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as Real;
\definition p: N.Nat^ := Nat.add one n;
\definition q: N.Nat^ := N.Nat^::succ m;
\import calculus.Real[].Multivariable[n := p].Open[] \as Open;
\import calculus.Real[].Multivariable[n := q].Open[] \as Output;
\import calculus.Maps[n := p, m := q] \as Maps;
\import \root.Euclidean[n := p, m := q] \as Euclidean;
\import \root.FlatMap[n := n, m := m] \as Flat;
\import \root.PositiveRank[n := n, m := m] \as Positive;
\import topological_algebra.Euclidean[].Dimension[n := p] \as Domain;
\import topological_algebra.Euclidean[].Dimension[n := q] \as Range;
\import topology.Topology[Carrier := Range.Point] \as RangeSets;
\import functional_analysis.Measure[A := Range.Point] \as Measure;
\import Measure.Sigma[] \as Sigma;
\import \root.Null[m := q] \as Null;

\module On(U: Open.OpenSet, V: Output.OpenSet, f: Maps.Map U V);
\definition theorem: SardIn n -> Euclidean.Sard :=
  \fun (lower: SardIn n)(U: Open.OpenSet)(V: Output.OpenSet)(f: Maps.Map U V) =>
    On[U := U, V := V, f := f].criticalNull lower;
