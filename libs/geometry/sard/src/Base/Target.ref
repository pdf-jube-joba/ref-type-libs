\import topological_algebra.Euclidean[].Dimension[n := n] \as Domain;
\import topological_algebra.Euclidean[].Dimension[n := N.Nat^::zero] \as Codomain;
\import calculus.Real[].Multivariable[n := n].Open[] \as Source;
\import calculus.Real[].Multivariable[n := N.Nat^::zero].Open[] \as Target;
\import calculus.Maps[n := n, m := N.Nat^::zero] \as Maps;
\import topology.Topology[Carrier := Codomain.Point] \as Sets;
\import \root.Null[m := N.Nat^::zero] \as Null;
\import \root.Euclidean[n := n, m := N.Nat^::zero] \as Euclidean;

\definition theorem: Euclidean.Sard :=
  \fun (U: Source.OpenSet)(V: Target.OpenSet)(f: Maps.Map U V) => \block {
    \let S: \Pow Codomain.Point := Euclidean.On[U := U, V := V, f := f].criticalValues \then
    \let empty: Sets.Subset S Sets.Empty :=
      \fun (y: Codomain.Point)(member: Sets.Member S y) => \block {
        \takefrom x: \Cast[Source.Carrier U]
          ({ t: Source.Carrier U \where Logic.And[Maps.apply U V f t = y,
            Euclidean.On[U := U, V := V, f := f].CriticalAt t] }) \by member \then
        \let witness: Logic.And[Maps.apply U V f x = y, Euclidean.On[U := U, V := V, f := f].CriticalAt x] :=
          \bysub(Source.Carrier U, { t: Source.Carrier U \where Logic.And[Maps.apply U V f t = y,
            Euclidean.On[U := U, V := V, f := f].CriticalAt t] }, x) \then
        \return witness.right
          (\fun (v: Codomain.Point) =>
            Logic.existsIntro[Domain.Point,
              { u: Domain.Point \where (Euclidean.On[U := U, V := V, f := f].differential x).apply u = v }]
              Domain.Def[].origin (Fin.Empty[A := Real.Real].unique _ v))
      } \then
    \return ZeroNull.included S Sets.Empty empty ZeroNull.empty
  };
