\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\import Real.Estimates[] \as Estimates;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import calculus.Blocks[n := p, m := n] \as Input;
\import calculus.Blocks[n := p, m := m] \as Output;
\import topological_algebra.Euclidean[].Dimension[n := p] \as Parameters;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Domain;
\import topological_algebra.Euclidean[].Dimension[n := m] \as Range;
\import topological_algebra.Euclidean[].Dimension[n := Input.dimension] \as InputSpace;
\import topological_algebra.Euclidean[].Dimension[n := Output.dimension] \as OutputSpace;
\import calculus.Vector[n := Input.dimension, m := Output.dimension] \as Vectors;
\import calculus.Vector[n := Input.dimension, m := m] \as Transverse;
\module On(D: Vectors.LinearMap, left: \forall (v: InputSpace.Point) -> Output.left (D.apply v) = Input.left v);
