\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition targetDimension: N.Nat^ := N.Nat^::succ m;
\import inverse_implicit.Product[n := n, m := one] \as G02;
\import calculus.Blocks[n := n, m := one] \as RightBlocks;
\import calculus.Blocks[n := one, m := n] \as LeftBlocks;
\import calculus.Blocks[n := one, m := m] \as TargetBlocks;
\import calculus.Real[].Multivariable[n := G02.dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := LeftBlocks.dimension].Open[] \as Parameter;
\import calculus.Real[].Multivariable[n := targetDimension].Open[] \as Output;
\import calculus.Real[].Multivariable[n := m].Open[] \as Transverse;
\import calculus.Real[].Multivariable[n := one].Open[] \as Line;
\import calculus.Maps[n := G02.dimension, m := targetDimension] \as Maps;
\import calculus.Maps[n := G02.dimension, m := one] \as ScalarMaps;
\import topological_algebra.Euclidean[].Dimension[n := G02.dimension] \as Domain;
\import topological_algebra.Euclidean[].Dimension[n := LeftBlocks.dimension] \as ProductSpace;
\import topological_algebra.Euclidean[].Dimension[n := targetDimension] \as Range;
\import topological_algebra.Euclidean[].Dimension[n := one] \as ScalarSpace;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Fiber;
\import topological_algebra.Euclidean[].Dimension[n := m] \as Remaining;
\import \root.Euclidean[n := G02.dimension, m := targetDimension] \as Full;
\import \root.Euclidean[n := n, m := m] \as Smaller;
\import \root.Null[m := targetDimension] \as Null;
\import \root.Scalar[n := G02.dimension] \as Scalar;
\import \root.SplitMap[p := one, n := n, m := m] \as Split;
\import topology.Topology[Carrier := Range.Point] \as RangeSets;
\import euclidean_measure.Euclidean[n := targetDimension] \as Lebesgue;
\module On(U: Open.OpenSet, V: Output.OpenSet, f: Maps.Map U V);
