\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import Real.FiniteSums[] \as Sums;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition p: N.Nat^ := inverse_implicit.Product[n := n, m := one].dimension;
\definition q: N.Nat^ := N.Nat^::succ m;
\import calculus.Real[].Multivariable[n := p].Open[] \as Open;
\import calculus.Real[].Multivariable[n := q].Open[] \as Target;
\import calculus.Real[].Multivariable[n := p].Space[].Linear[] \as Linear;
\import calculus.Maps[n := p, m := q] \as Maps;
\import topological_algebra.Euclidean[].Dimension[n := p] \as Domain;
\import topological_algebra.Euclidean[].Dimension[n := q] \as Output;
\import \root.Taylor[n := p] \as Taylor;
\import \root.Scalar[n := p] \as Scalar;
\import \root.Hypersurface[n := n, m := m] \as Hypersurface;
\import \root.Euclidean[n := n, m := q] \as Smaller;
\import \root.Null[m := q] \as Null;
\import functional_analysis.Measure[A := Output.Point].Sigma[] \as Classical;
\import topology.Topology[Carrier := Output.Point] \as OutputSets;
\import Open.Smooth[].Derivative[] \as Partials;
\module On(U: Open.OpenSet, V: Target.OpenSet, f: Maps.Map U V);
