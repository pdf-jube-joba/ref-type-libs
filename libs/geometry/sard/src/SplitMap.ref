\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import calculus.Blocks[n := p, m := n] \as Input;
\import calculus.Blocks[n := p, m := m] \as Output;
\import calculus.Real[].Multivariable[n := Input.dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := Output.dimension].Open[] \as Target;
\import calculus.Real[].Multivariable[n := m].Open[] \as RangeOpen;
\import calculus.Real[].Multivariable[n := p].Open[] \as ParameterOpen;
\import calculus.Real[].Multivariable[n := n].Open[] \as FiberOpen;
\import calculus.Maps[n := Input.dimension, m := p] \as Projections;
\import calculus.Maps[n := Input.dimension, m := m] \as Remainders;
\import calculus.Maps[n := Input.dimension, m := Output.dimension] \as Maps;
\import calculus.Maps[n := n, m := Input.dimension] \as Inclusions;
\import topological_algebra.Euclidean[].Dimension[n := p] \as Parameter;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Fiber;
\import topological_algebra.Euclidean[].Dimension[n := m] \as Range;
\import topological_algebra.Euclidean[].Dimension[n := Input.dimension] \as SourceSpace;
\import topological_algebra.Euclidean[].Dimension[n := Output.dimension] \as TargetSpace;
\import \root.Sections[p := p, q := m] \as ProductSections;
\import \root.Euclidean[n := n, m := m] \as Smaller;
\import \root.Euclidean[n := Input.dimension, m := Output.dimension] \as Total;
\import \root.Null[m := m] \as Null;
\import \root.Null[m := Output.dimension] \as TargetNull;
\import topology.Topology[Carrier := TargetSpace.Point] \as TargetSets;
\import topology.Topology[Carrier := Range.Point] \as RangeSets;
\import inverse_implicit.Product[n := p, m := n] \as SourceProduct;
\import \root.BlockDerivative[p := p, n := n, m := m] \as Block;
\module On(U: Open.OpenSet, h: Remainders.Map U RangeOpen.whole);
