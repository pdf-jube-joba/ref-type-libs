\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition targetDimension: N.Nat^ := N.Nat^::succ m;
\import inverse_implicit.Product[n := n, m := one] \as Product;
\import calculus.Real[].Multivariable[n := Product.dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := one].Open[] \as Line;
\import calculus.Real[].Multivariable[n := n].Open[] \as Parameter;
\import calculus.Real[].Multivariable[n := targetDimension].Open[] \as Output;
\import calculus.Maps[n := Product.dimension, m := one] \as ScalarMaps;
\import calculus.Maps[n := Product.dimension, m := targetDimension] \as Maps;
\import calculus.Maps[n := n, m := targetDimension] \as ParamMaps;
\import calculus.Maps[n := n, m := Product.dimension] \as Charts;
\import topological_algebra.Euclidean[].Dimension[n := Product.dimension] \as SourceSpace;
\import topological_algebra.Euclidean[].Dimension[n := one] \as ScalarSpace;
\import topological_algebra.Euclidean[].Dimension[n := targetDimension] \as TargetSpace;
\import topological_algebra.Euclidean[].Dimension[n := n] \as ParameterSpace;
\import topology.Topology[Carrier := TargetSpace.Point] \as TargetSets;
\import \root.Euclidean[n := n, m := targetDimension] \as Smaller;
\import \root.Euclidean[n := Product.dimension, m := targetDimension] \as Full;
\import \root.Null[m := targetDimension] \as Null;
\module On(U: Open.OpenSet, V: Output.OpenSet, f: Maps.Map U V, g: ScalarMaps.Map U Line.whole, value: ScalarSpace.Point);
