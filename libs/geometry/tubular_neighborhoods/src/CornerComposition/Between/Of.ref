\import manifold_gluing.SmoothChainRule[n := n,m := m,l := l].Between[M := M,N := N,P := P].Of[f := f,g := g] \as Chain;
\import boundary_manifolds.SmoothMap[n := n,m := l].Between[M := M,N := P] \as Maps;
\definition map: Maps.Map := Chain.map;
\module At(x: M.Point);
\import boundary_manifolds.Immersion[n := n,m := m].Between[M := M,N := N] \as FirstImmersions;
\import boundary_manifolds.Immersion[n := m,m := l].Between[M := N,N := P] \as SecondImmersions;
\import boundary_manifolds.Immersion[n := n,m := l].Between[M := M,N := P] \as Immersions;
\definition immersion[first: FirstImmersions.IsImmersion f][second: SecondImmersions.IsImmersion g]: Immersions.IsImmersion map :=
  \fun (x: M.Point)(a,b: boundary_manifolds.Tangent[n := n].On[M := M].Vector x)(same: _) =>
    At[x := x].compose (first x) (second (First.apply f x)) a b same;
