\import boundary_manifolds.Tangent[n := n].On[M := M].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := m].On[M := N].At[x := f.apply x] \as Middle;
\import boundary_manifolds.Tangent[n := l].On[M := P].At[x := map.apply x] \as Range;
\import boundary_manifolds.Differential[n := n,m := m].Between[M := M,N := N].At[f := f,x := x] \as Df;
\import boundary_manifolds.Differential[n := m,m := l].Between[M := N,N := P].At[f := g,x := f.apply x] \as Dg;
\import boundary_manifolds.Differential[n := n,m := l].Between[M := M,N := P].At[f := map,x := x] \as D;
\definition FirstInjective: \Prop := \forall (a,b: Domain.Vector) -> Df.value.apply a = Df.value.apply b -> a = b;
\definition SecondInjective: \Prop := \forall (a,b: Middle.Vector) -> Dg.value.apply a = Dg.value.apply b -> a = b;
\definition CompositeInjective: \Prop := \forall (a,b: Domain.Vector) -> D.value.apply a = D.value.apply b -> a = b;
\definition compose[first: FirstInjective][second: SecondInjective]: CompositeInjective :=
  \fun (a,b: Domain.Vector)(same: _) => first a b
    (second (Df.value.apply a) (Df.value.apply b)
      (trans!{{Range.Vector}} _ _ _ (sym!{{Range.Vector}} _ _ (Chain.At[x := x].pointwise a))
        (trans!{{Range.Vector}} _ _ _ same (Chain.At[x := x].pointwise b))));
\definition first[composite: CompositeInjective]: FirstInjective :=
  \fun (a,b: Domain.Vector)(same: _) => composite a b
    (trans!{{Range.Vector}} _ _ _ (Chain.At[x := x].pointwise a)
      (trans!{{Range.Vector}} _ _ _ (congr!{{Middle.Vector} {Range.Vector}} Dg.value.apply _ _ same)
        (sym!{{Range.Vector}} _ _ (Chain.At[x := x].pointwise b))));
\definition second[composite: CompositeInjective]
  [onto: \forall (w: Middle.Vector) -> \exists (v: Domain.Vector \where Df.value.apply v = w)]: SecondInjective := \block {
  \fun (a,b: Middle.Vector)(same: _) \then
  \takefrom u: \Cast[Domain.Vector] ({ v: Domain.Vector \where Df.value.apply v = a }) \by onto a \then
  \takefrom v: \Cast[Domain.Vector] ({ v: Domain.Vector \where Df.value.apply v = b }) \by onto b \then
  \let first: Df.value.apply u = a := \bysub(Domain.Vector,{ w: Domain.Vector \where Df.value.apply w = a },u) \then
  \let second: Df.value.apply v = b := \bysub(Domain.Vector,{ w: Domain.Vector \where Df.value.apply w = b },v) \then
  \let left: D.value.apply u = Dg.value.apply a := trans!{{Range.Vector}} _ _ _
    (Chain.At[x := x].pointwise u) (congr!{{Middle.Vector} {Range.Vector}} Dg.value.apply _ _ first) \then
  \let right: D.value.apply v = Dg.value.apply b := trans!{{Range.Vector}} _ _ _
    (Chain.At[x := x].pointwise v) (congr!{{Middle.Vector} {Range.Vector}} Dg.value.apply _ _ second) \then
  \return trans!{{Middle.Vector}} _ _ _ (sym!{{Middle.Vector}} _ _ first)
    (trans!{{Middle.Vector}} _ _ _
      (congr!{{Domain.Vector} {Middle.Vector}} Df.value.apply _ _
        (composite u v (trans!{{Range.Vector}} _ _ _ left (trans!{{Range.Vector}} _ _ _ same (sym!{{Range.Vector}} _ _ right)))))
      second)
};
