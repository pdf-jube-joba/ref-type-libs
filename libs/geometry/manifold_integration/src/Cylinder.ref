\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].trans;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import calculus.Real[].OneDimension[] \as One;
\import Fin.Sum[m := n, n := One.dimension] \as Indices;
\definition dimension: N.Nat^ := Indices.total;
\import Indices.Tuples[A := Real.Real] \as Tuples;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import euclidean_measure.Euclidean[n := n] \as Base;
\import euclidean_measure.Euclidean[n := One.dimension] \as Axis;
\import euclidean_measure.Euclidean[n := dimension] \as E;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as BaseTopology;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension].Topology[] \as AxisTopology;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Topology[] \as Topology;
\import topology.Topology[Carrier := Base.Point] \as BaseSets;
\import topology.Topology[Carrier := Axis.Point] \as AxisSets;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import metric_spaces.RealLine[] \as RealLine;
\import \root.Interval[interval := interval].Box[] \as Box;
\module Join(X: \Set, source: topology.Topology[Carrier := X].Topology, left: X -> Base.Point, right: X -> Axis.Point);
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\module Over(K: \Pow Base.Point, compact: BaseSets.IsCompactIn BaseTopology.topology K);
