\import real.Analysis[].Algebra[] \as Algebra;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.FiniteCoordinates[n := dimension] \as Basis;
\import Basis.Top[] \as Volume;
\import Spaces.Coordinates[I := Fin.Fin dimension] \as Vectors;
\import Spaces.Multilinear[V := E.Point, space := Vectors.space] \as Multilinear;
\import Multilinear.Alternating[].DegreeZero[] \as Empty;
\import manifold_gluing.BoundarySigns[n := One.dimension].On[V := E.Point, space := Vectors.space] \as Faces;
\import manifold_gluing.BoundarySigns[n := N.Nat^::zero].On[V := E.Point, space := Vectors.space].Corner[] \as Swap;
\import Fin.Tuples[A := E.Point] \as Tuples;
\definition ex: E.Point := Basis.vectors xIndex;
\definition ey: E.Point := Basis.vectors yIndex;
\definition xArguments[i: One.Index]: E.Point := ex;
\definition yArguments[i: One.Index]: E.Point := ey;
\definition frame: Volume.Arguments := Tuples.extend One.dimension ex yArguments;
\definition frameLaw: frame = Volume.basisArguments :=
  \axiom:funext(frame, Volume.basisArguments, Fin.cases One.dimension (\fun (i: Fin.Fin dimension) => frame i = Volume.basisArguments i)
    (Tuples.atZero One.dimension ex yArguments)
    (\fun (i: One.Index) => trans!{{E.Point}} _ _ _ (Tuples.atSuccessor One.dimension ex yArguments i)
      (congr!{{Fin.Fin dimension} {E.Point}} Basis.vectors _ _
        (congr!{{One.Index} {Fin.Fin dimension}} (Fin.succ One.dimension) _ _ (sym!{{One.Index}} _ _ (Fin.singletonValue i))))));
\definition right: Faces.inward Volume.volume ex yArguments = Real.one :=
  trans!{Real.Real} _ _ _ (congr!{{Volume.Arguments} Real.Real} Volume.volume _ _ frameLaw) Volume.normalized;
\definition left: Faces.outward Volume.volume ex yArguments = Real.neg Real.one :=
  trans!{Real.Real} _ _ _ (Faces.normalOppositeValue Volume.volume ex yArguments)
    (congr!{Real.Real Real.Real} Real.neg _ _ right);
\definition tail[v: E.Point]: Tuples.extend N.Nat^::zero v Empty.emptyArguments = (\fun (i: One.Index) => v) :=
  \axiom:funext(Tuples.extend N.Nat^::zero v Empty.emptyArguments, (\fun (i: One.Index) => v), \fun (i: One.Index) =>
    trans!{{E.Point}} _ _ _
      (congr!{{One.Index} {E.Point}} (Tuples.extend N.Nat^::zero v Empty.emptyArguments) _ _ (Fin.singletonValue i))
      (Tuples.atZero N.Nat^::zero v Empty.emptyArguments));
\definition top: Faces.inward Volume.volume ey xArguments = Real.neg Real.one :=
  trans!{Real.Real} _ _ _
    (congr!{{Multilinear.Arguments One.dimension} Real.Real} (Faces.inward Volume.volume ey) _ _ (sym!{{Multilinear.Arguments One.dimension}} _ _ (tail ex)))
    (trans!{Real.Real} _ _ _ (Swap.swapNormal Volume.volume ex ey Empty.emptyArguments)
      (trans!{Real.Real} _ _ _
        (congr!{{Multilinear.Arguments One.dimension} Real.Real} (\fun (v: Multilinear.Arguments One.dimension) => Real.neg (Faces.inward Volume.volume ex v)) _ _ (tail ey))
        (congr!{Real.Real Real.Real} Real.neg _ _ right)));
\definition bottom: Faces.outward Volume.volume ey xArguments = Real.one :=
  trans!{Real.Real} _ _ _ (Faces.normalOppositeValue Volume.volume ey xArguments)
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Real.neg _ _ top) (Laws.negInvolutive Real.one));
