\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import Real.Estimates[].Product[] \as Absolute;
\import \parent.Chart[U := U] \as Source;
\import \parent.Chart[U := V] \as Target;
\import Change.TopCoordinates[U := U] \as SourceCoordinates;
\import Change.TopCoordinates[U := V] \as TargetCoordinates;
\import Change.Localization[U := U] \as SourceLocalization;
\import Change.Localization[U := V] \as TargetLocalization;
\import Change.Jacobian[U := U, V := V, f := e.forward] \as Jacobian;
\import Change.TopForm[U := U, V := V, f := e.forward] \as TopForm;
\import Forms.Pullback[m := n, U := U, V := V, f := e.forward] \as Pullback;
\import Change.Diffeomorphism[U := U, V := V, e := e] \as ChangeChart;
\import Integral.Negation[] \as Negation;
\definition Preserving: \Prop := \forall (x: Open.Carrier U) -> R.Le Real.zero (Jacobian.signed x);
\definition Reversing: \Prop := \forall (x: Open.Carrier U) -> R.Lt (Jacobian.signed x) Real.zero;
\definition pullback[omega: Target.Form]: Source.Form := Pullback.apply n omega;
\module For(omega: Target.Form, supported: Target.Supported omega);
