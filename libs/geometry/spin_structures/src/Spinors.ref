\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import complex.Complex[] \as C;
\import C.Def[] \as Def;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Spaces;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Finite[n := k] \as Finite;
\import spinor_representations.Over[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field].On[V := Finite.Vector, space := Finite.space].Total[] \as Fock;
\import spinor_representations.Complex[].Dimension[n := k].RealCoordinates[] \as RealCoordinates;
\import RealCoordinates.Clifford[] \as Action;
\import Action.Spin[] \as Spin;
\import Spin.Phase[] \as SpinC;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field].CoordinateSum[n := k, m := k] \as Sum;
\definition rank: N.Nat^ := Sum.dimension;
\import lie_groups.Euclidean[n := rank] \as E;
\import clifford.Euclidean[n := rank] \as Clifford;
\import clifford.Field[K := R.Real, field := R.Algebra[].field].On[V := E.Vector, space := E.space].Of[form := E.form] \as RealAlgebra;
\import lie_algebras.Field[K := C.Complex, field := C.Algebra[].field].Endomorphisms[V := Fock.Carrier, space := Fock.totalSpace] \as End;
\import algebra.Groups[].Units[A := End.Carrier, ring := End.ring] \as Units;
\module In(s: N.Nat^);
