\import Spaces.Linear[V := Fock.Carrier, W := Fock.Carrier, source := Fock.totalSpace, target := Fock.totalSpace].Composition[
  U := GL.Vector, domain := GL.coordinates] \as InputEnd;
\import Spaces.Linear[V := Fock.Carrier, W := GL.Vector, source := Fock.totalSpace, target := GL.coordinates].Composition[
  U := GL.Vector, domain := GL.coordinates] \as Output;
\import Spaces.Isomorphism[V := GL.Vector, W := GL.Vector, source := GL.coordinates, target := GL.coordinates] \as Target;
\definition linear[a: End.Carrier]: GL.Map := Output.compose coordinates.forward (InputEnd.compose a coordinates.backward);
\definition cancel: \forall (a: End.Carrier)(v: Fock.Carrier) ->
    a.apply (coordinates.backward.apply (coordinates.forward.apply v)) = a.apply v :=
  \fun (a: End.Carrier)(v: Fock.Carrier) => congr!{{Fock.Carrier} {Fock.Carrier}} a.apply _ _ (coordinates.leftInverse v);
\definition coordinateAction[u: Units.Unit]: GL.Carrier := Target.Isomorphism {
  forward := linear u.value, backward := linear u.inverse,
  leftInverse := \fun (v: GL.Vector) => trans!{{GL.Vector}} _ _ _
    (congr!{{Fock.Carrier} {GL.Vector}} coordinates.forward.apply _ _ (cancel u.inverse (u.value.apply (coordinates.backward.apply v))))
    (trans!{{GL.Vector}} _ _ _
      (congr!{{End.Carrier} {GL.Vector}} (\fun (a: End.Carrier) => (linear a).apply v) _ _ u.left)
      (coordinates.rightInverse v)),
  rightInverse := \fun (v: GL.Vector) => trans!{{GL.Vector}} _ _ _
    (congr!{{Fock.Carrier} {GL.Vector}} coordinates.forward.apply _ _ (cancel u.value (u.inverse.apply (coordinates.backward.apply v))))
    (trans!{{GL.Vector}} _ _ _
      (congr!{{End.Carrier} {GL.Vector}} (\fun (a: End.Carrier) => (linear a).apply v) _ _ u.right)
      (coordinates.rightInverse v)),
};
\import algebra.Hom[A := Units.Unit, B := GL.Carrier] \as Hom;
\definition transport: Hom.GroupMap Units.group GL.group :=
  \into[Units.Unit -> GL.Carrier](coordinateAction, Hom.GroupMap Units.group GL.group) \by {
    Hom.MonoidLaws[_, _, coordinateAction] {
      unit := GL.ext (coordinateAction Units.unit) GL.identity coordinates.rightInverse,
      operation := \fun (a, b: Units.Unit) => GL.ext (coordinateAction (Units.product a b)) (GL.multiply (coordinateAction a) (coordinateAction b))
        (\fun (v: GL.Vector) => congr!{{Fock.Carrier} {GL.Vector}} coordinates.forward.apply _ _
          (sym!{{Fock.Carrier}} _ _ (cancel a.value (b.value.apply (coordinates.backward.apply v))))),
    }
  };
\import algebra.Hom[A := E.Spin, B := Units.Unit].Composition[C := GL.Carrier] \as SpinHom;
\import algebra.Hom[A := E.SpinC, B := Units.Unit].Composition[C := GL.Carrier] \as SpinCHom;
\definition spin: algebra.Hom[A := E.Spin, B := GL.Carrier].GroupMap E.spinGroup GL.group :=
  SpinHom.groupMap E.spinGroup Units.group GL.group Spin.homomorphism transport;
\definition spinC: algebra.Hom[A := E.SpinC, B := GL.Carrier].GroupMap E.spinCGroup GL.group :=
  SpinCHom.groupMap E.spinCGroup Units.group GL.group SpinC.homomorphism transport;
\module Coefficient(v: GL.Vector, a: Fin.Fin s);
\module Regular(n: N.Nat^);
\module Over(n: N.Nat^);
