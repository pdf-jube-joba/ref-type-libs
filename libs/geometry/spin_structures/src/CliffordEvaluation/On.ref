\import clifford.Euclidean[n := r] \as E;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Algebra;
\structure Functional: \Set := {
  apply: E.Carrier -> R.Real,
  add: \forall (a, b: E.Carrier) -> apply (Algebra.add a b) = R.add (apply a) (apply b),
  scale: \forall (c: R.Real)(a: E.Carrier) -> apply (Algebra.scale c a) = R.mul c (apply a),
};
\definition Law: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> E.Carrier)(ell: Functional) ->
  Plots.Dimension[n := r].Plot U f -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => ell.apply (f x));
\module Successor;
