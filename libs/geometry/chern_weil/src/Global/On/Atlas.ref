\import std.Logic[].Proposition[] \as Logic;
\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as Atlases;
\import differential_forms.AtlasForms[n := n].On[M := M] \as AtlasForms;
\definition Indices[c: Charts.Chart]: \Set := \Cast[I] ({ i: I \where chart i = c });
\definition members: \Pow Charts.Chart := { c: Charts.Chart \where \exists Indices c };
\definition data: Atlases.Data := Atlases.Data { charts := members };
\definition member[i: I]: \In[Charts.Chart] members (chart i) :=
  \exact(\into[I](i, Indices (chart i)) \by { \refl(chart i) }, Indices (chart i));
\definition included: \forall (c: Charts.Chart) -> \In[Charts.Chart] members c -> \In[Charts.Chart] M.atlas.charts c := \block {
  \fun (c: Charts.Chart)(inAtlas: \exists Indices c) \then
  \takefrom i: Indices c \by inAtlas \then
  \return \idelim chart i = c \with d: Charts.Chart => \In[Charts.Chart] M.atlas.charts d \by {
    base: BaseForms.member (chart i), equality: \bysub(I, Indices c, i)
  }
};
\definition covered: \forall (x: M.Point) -> \exists (c: Charts.Chart \where Logic.And[Atlases.Member data c, Charts.Contains c x]) := \block {
  \fun (x: M.Point) \then
  \takefrom i: \Cast[I] ({ j: I \where Charts.Contains (chart j) x }) \by covers x \then
  \return Logic.existsIntro[Charts.Chart, { c: Charts.Chart \where Logic.And[Atlases.Member data c, Charts.Contains c x] }] (chart i)
    (Logic.And[_, _]::# (member i) (\bysub(I, { j: I \where Charts.Contains (chart j) x }, i)))
};
\definition atlas: AtlasForms.EmbeddedAtlas :=
  \into[Atlases.Atlas](
    \into[Atlases.Data](data, Atlases.Atlas) \by {
      Atlases.Laws[data] {
        covers := covered,
        compatible := \fun (c, d: Charts.Chart)(hc: _)(hd: _) => M.atlas.compatible c d (included c hc) (included d hd),
      }
    }, AtlasForms.EmbeddedAtlas) \by { included };
\import AtlasForms.Of[atlas := atlas] \as Small;
\definition chartOf[i: I]: Small.Chart := \into[Charts.Chart](chart i, members) \by { member i };
\module Overlap(c, d: BaseForms.Chart) {
  \import Charts.Transition[left := c, right := d] \as Domain;
  \import BaseForms.Pair[left := c, right := d] \as ChartPair;
  \import Euclidean.Restriction[U := Domain.domain, V := c.image] \as Restriction;
  \import Euclidean.Pullback[m := n, U := Domain.domain, V := d.image, f := ChartPair.transition] \as Pullback;
  \definition restrict[k: N.Nat^][omega: Euclidean.LocalForm c.image k]: Euclidean.LocalForm Domain.domain k :=
    Restriction.apply k ChartPair.included omega;
  \definition pull[k: N.Nat^][omega: Euclidean.LocalForm d.image k]: Euclidean.LocalForm Domain.domain k :=
    Pullback.apply k omega;
  \definition agrees[k: N.Nat^][alpha: Euclidean.LocalForm c.image k][beta: Euclidean.LocalForm d.image k]: \Prop :=
    restrict k alpha = pull k beta;
}
\definition Agreement[c, d: BaseForms.Chart][k: N.Nat^][alpha: Euclidean.LocalForm c.image k][beta: Euclidean.LocalForm d.image k]: \Prop :=
  Overlap[c := c, d := d].agrees k alpha beta;
\module Self(c: BaseForms.Chart);
\module Glue(k: N.Nat^, forms: \forall (i: I) -> Euclidean.LocalForm (chart i).image k,
  overlaps: \forall (i, j: I) -> Agreement (chart i) (chart j) k (forms i) (forms j));
\module At(k: N.Nat^) {
  \import Small.At[k := k] \as SmallForms;
  \definition ext: \forall (omega, eta: BaseForms.Form k) -> (\forall (i: I) -> omega (chart i) = eta (chart i)) -> omega = eta :=
    \fun (omega, eta: BaseForms.Form k)(same: _) => SmallForms.injective omega eta
      (Small.ext k (SmallForms.restrict omega) (SmallForms.restrict eta) (\fun (c: Small.Chart) => \block {
        \takefrom i: Indices c \by \bysub(Charts.Chart, members, c) \then
        \return \idelim (chartOf i) = c \with d: Small.Chart => SmallForms.restrict omega d = SmallForms.restrict eta d \by {
          base: same i, equality: \bysub(I, Indices c, i)
        }
      }));
}
