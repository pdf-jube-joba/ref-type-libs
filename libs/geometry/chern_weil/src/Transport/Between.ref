\import \root.Local[n := n, r := r].On[U := U] \as Source;
\import \root.Local[n := m, r := r].On[U := V] \as Target;
\import euclidean_forms.Euclidean[n := n].On[U := U] \as SourceForms;
\import euclidean_forms.Euclidean[n := m].On[U := V] \as TargetForms;
\import bundle_connections.Forms[n := n, r := r].On[U := U] \as SourceConnections;
\import bundle_connections.Forms[n := m, r := r].On[U := V] \as TargetConnections;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition Linear[k: N.Nat^]: \Set := Spaces.Linear[V := TargetForms.Form k, W := SourceForms.Form k,
  source := TargetForms.At[k := k].space, target := SourceForms.At[k := k].space].Map;
\module Using(maps: \forall (k: N.Nat^) -> Linear k);
\module Pullback(f: calculus.Maps[n := n, m := m].Map U V);
