\import BundlesPull.In[i := i] \as Coordinates;
\definition c: SourceForms.Chart := Coordinates.c;
\definition d: TargetForms.Chart := Coordinates.d;
\import Maps.Coordinates[f := f, left := c, right := d] \as Patch;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import calculus.Maps[n := n, m := m].Restriction[U := c.image, V := Patch.domain, W := d.image] \as MapRestriction;
\import euclidean_forms.Euclidean[n := n].On[U := c.image] \as Scalar;
\import euclidean_forms.Euclidean[n := m].On[U := d.image] \as TargetScalar;
\import euclidean_forms.Euclidean[n := n].Pullback[m := m, U := c.image, V := d.image, f := Coordinates.map] \as ScalarPull;
\import \root.Transport[n := n, m := m, r := r].Between[U := c.image, V := d.image].Pullback[f := Coordinates.map] \as MatrixPull;
\import \root.Local[n := n, r := r].On[U := c.image] \as SourceLocal;
\import \root.Local[n := m, r := r].On[U := d.image] \as TargetLocal;
\import SourceLocal.Curvature[connection := PulledConnection.value i] \as PulledCurvature;
\import TargetLocal.Curvature[connection := connection i.target] \as OriginalCurvature;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Coordinates[I := Fin.Fin m] \as TargetVectors;
\import Spaces.Linear[V := Vectors.Vector, W := TargetVectors.Vector, source := Vectors.space, target := TargetVectors.space] \as Linear;
\module AtDegree(k: N.Nat^) {
  \import Pull.At[k := k] \as ByDegree;
  \import ByDegree.Local[chart := c, right := d] \as LocalPull;
  \definition law: \forall (omega: TargetForms.Form k) -> ByDegree.apply omega c = ScalarPull.apply k (omega d) :=
    \fun (omega: TargetForms.Form k) => Scalar.ext k _ _ (\fun (u: Open.Carrier c.image)(args: Fin.Fin k -> Vectors.Vector) =>
      trans!{R.Real} _ _ _
        (LocalPull.pointwise omega (Open.inclusion c.image Patch.domain Coordinates.included u) args)
        (sym!{R.Real} _ _ (congr!{{Linear.Map} {R.Real}}
          (\fun (J: Linear.Map) => omega d (Coordinates.map.apply u) (\fun (a: Fin.Fin k) => J.apply (args a))) _ _
          (MapRestriction.differential Coordinates.included (Patch.map Coordinates.smooth) u))));
}
\definition law: FormsPull.apply TargetTrace.form c = SourceTrace.form c :=
  eq_reason_in!{{Scalar.Form two} _
    "=" _ "by" { AtDegree[k := two].law TargetTrace.form }
    "=" {ScalarPull.apply two (TargetLocal.Trace[k := two].apply OriginalCurvature.value)} "by" {
      congr!{{TargetScalar.Form two} {Scalar.Form two}} (ScalarPull.apply two) _ _ (TargetTrace.coordinates i.target) }
    "=" _ "by" { MatrixPull.trace two OriginalCurvature.value }
    "=" {SourceLocal.Trace[k := two].apply PulledCurvature.value} "by" {
      congr!{{SourceLocal.Matrix two} {Scalar.Form two}} SourceLocal.Trace[k := two].apply _ _ (MatrixPull.curvature (connection i.target)) }
    "=" _ "by" { sym!{{Scalar.Form two}} _ _ (SourceTrace.coordinates i) }
  };
\import SourceLocal.Product[p := two, q := two] \as SquareProduct;
\import SourceLocal.Curvature[connection := PulledConnection.value i].QuadraticTrace[] \as PulledSquare;
\import TargetLocal.Curvature[connection := connection i.target].QuadraticTrace[] \as OriginalSquare;
\definition square: MatrixPull.apply four OriginalSquare.square = PulledSquare.square :=
  trans!{{SourceLocal.Matrix four}} _ _ _ (MatrixPull.Product[p := two, q := two].law OriginalCurvature.value OriginalCurvature.value)
    (congr!{{SourceLocal.Matrix two} {SourceLocal.Matrix two} {SourceLocal.Matrix four}} SquareProduct.apply _ _ _ _
      (MatrixPull.curvature (connection i.target)) (MatrixPull.curvature (connection i.target)));
\definition quadratic: QuadraticPull.apply TargetQuadratic.form c = SourceQuadratic.form c :=
  eq_reason_in!{{Scalar.Form four} _
    "=" _ "by" { AtDegree[k := four].law TargetQuadratic.form }
    "=" {ScalarPull.apply four (TargetLocal.Trace[k := four].apply OriginalSquare.square)} "by" {
      congr!{{TargetScalar.Form four} {Scalar.Form four}} (ScalarPull.apply four) _ _ (TargetQuadratic.coordinates i.target) }
    "=" _ "by" { MatrixPull.trace four OriginalSquare.square }
    "=" {SourceLocal.Trace[k := four].apply PulledSquare.square} "by" {
      congr!{{SourceLocal.Matrix four} {Scalar.Form four}} SourceLocal.Trace[k := four].apply _ _ square }
    "=" _ "by" { sym!{{Scalar.Form four}} _ _ (SourceQuadratic.coordinates i) }
  };
