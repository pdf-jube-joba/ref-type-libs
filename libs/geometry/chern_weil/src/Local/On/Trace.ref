\definition next: N.Nat^ := N.Nat^::succ k;
\import \parent.At[k := k] \as Source;
\import \parent.At[k := next] \as Target;
\import Scalar.At[k := k] \as Forms;
\import Scalar.At[k := next] \as NextForms;
\import Scalar.ExteriorDerivative[k := k] \as D;
\import Spaces.Laws[V := Scalar.Form k, space := Forms.space] \as Laws;
\import Spaces.Sums[I := Fin.Fin r].Vector[V := Scalar.Form k, space := Forms.space] \as Sums;
\import Sums.Mapping[W := Scalar.Form next, target := NextForms.space] \as DerivativeSum;
\definition apply[A: Matrix k]: Scalar.Form k := Source.sum (\fun (a: Fin.Fin r) => A a a);
\definition origin: apply Source.origin = Forms.zero := Sums.zero (Fin.elements r);
\definition addition: \forall (A, B: Matrix k) -> apply (Source.plus A B) = Forms.plus (apply A) (apply B) :=
  \fun (A, B: Matrix k) => Sums.addition (Fin.elements r) (\fun (a: Fin.Fin r) => A a a) (\fun (a: Fin.Fin r) => B a a);
\definition negative: \forall (A: Matrix k) -> apply (Source.negative A) = Laws.negative (apply A) :=
  \fun (A: Matrix k) => Sums.negative (Fin.elements r) (\fun (a: Fin.Fin r) => A a a);
\definition differential: \forall (A: Matrix k) -> D.apply (apply A) = Target.sum (\fun (a: Fin.Fin r) => derivative k A a a) :=
  \fun (A: Matrix k) => DerivativeSum.law D.map (Fin.elements r) (\fun (a: Fin.Fin r) => A a a);
