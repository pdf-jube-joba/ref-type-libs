\use Equality.eq_reason_in;
\import Real.Distance[] \as Distance;
\import Real.Estimates[] \as Estimates;
\import metric_spaces.MetricSpace[Carrier := Target.Point] \as Metrics;
\import Metrics.Topology[] \as Balls;
\import \parent.\parent.Cutoff[K := K, U := U, open := open] \as Cutoff;
\import sard.Corners[n := n, m := m].Between[M := M, N := Euclidean.manifold].Of[f := f] \as Original;
\definition origin: Euclidean.Point :=
  \into[Output.Carrier Output.whole](Output.Whole[].point Def.origin, TargetModel.region TargetModel.unconstrained Output.whole) \by {
    TargetModel.unconstrainedNonnegative Def.origin
  };
\definition RegularOnProtected: \Prop :=
  \forall (x: M.Point) -> Space.Member U x -> f.apply x = origin -> Original.TangentialSurjective x;
\structure Result[radius: Real.Real]: \Set := {
  map: Maps.Map,
  neighborhood: \Pow M.Point,
  neighborhoodOpen: Space.IsOpenIn M.space neighborhood,
  contains: Space.Subset K neighborhood,
  agrees: \forall (x: M.Point) -> Space.Member neighborhood x -> map.apply x = f.apply x,
  regular: sard.Corners[n := n, m := m].Between[M := M, N := Euclidean.manifold].Of[f := map].TangentialRegular origin,
  close: \forall (x: M.Point) -> R.Lt (Def.pointDistance (map.apply x) (f.apply x)) radius,
};
\module With(cutoff: Cutoff.Data);
\definition exists[compact: Space.IsCompact M.space][radius: Real.Real][positive: R.Lt Real.zero radius]
  [given: RegularOnProtected]: \exists Result[radius] := \block {
  \takefrom cutoff: Cutoff.Data \by Cutoff.exists (Compact.closedSubset M.space Space.Whole K compact closed (\fun (x: M.Point)(inK: _) => \refl(x))) included \then
  \let result: \exists Result[radius] := With[cutoff := cutoff].exists radius positive given \then
  \return result
};
