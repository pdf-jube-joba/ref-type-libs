\import \root.CornerScalars[n := n].On[M := M].Cutoff[K := K, U := U, open := open] \as Cutoff;
\module With(cutoff: Cutoff.Data, radius: Real.Real, positive: R.Lt Real.zero radius, regular: SmoothOn f U);
\definition compactK[compact: Space.IsCompact M.space]: Space.IsCompactIn M.space K :=
  Compact.closedSubset M.space Space.Whole K compact closed (\fun (x: M.Point)(inK: _) => \refl(x));
\definition exists[compact: Space.IsCompact M.space][regular: SmoothOn f U][radius: Real.Real][positive: R.Lt Real.zero radius]:
  \exists Result[radius, K] := \block {
  \takefrom cutoff: Cutoff.Data \by Cutoff.exists (compactK compact) included \then
  \return With[cutoff := cutoff, radius := radius, positive := positive, regular := regular].exists compact
};
