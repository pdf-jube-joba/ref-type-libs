\import manifolds.Composition[n := n, m := Nat.add m n, l := r].Between[M := preimage, N := M, P := P] \as Composition;
\import manifolds.SmoothMap[n := n, m := r].Between[M := preimage, N := P] \as LevelMaps;
\definition parameterMap: LevelMaps.Map := Composition.compose Smooth.inclusion projection;
\import sard.Manifold[n := n, m := r].Between[M := preimage, N := P].Of[f := parameterMap] \as Sard;
\import manifolds.DifferentialComposition[n := n, m := Nat.add m n, l := r].Between[M := preimage, N := M, P := P]
  .Of[f := Smooth.inclusion, g := projection] \as Chain;
\import manifolds.Differential[n := Nat.add m n, m := r].Between[M := M, N := P] \as ParameterDerivative;
\import manifolds.Differential[n := n, m := Nat.add m n].Between[M := preimage, N := M] \as InclusionDerivative;
\import manifolds.Differential[n := n, m := r].Between[M := preimage, N := P] \as LevelDerivative;
\import manifolds.Tangent[n := r].On[M := P] \as ParameterTangent;
\import topology.Topology[Carrier := P.Point] \as Sets;
\module At(x: Level.Fiber);

\definition RegularParameter[t: P.Point]: \Prop :=
  \forall (x: Level.Fiber) -> projection.apply x = t -> At[x := x].SliceRegular;
\definition regularParameter[t: P.Point]: Sard.Regular t -> RegularParameter t :=
  \fun (good: Sard.Regular t)(x: Level.Fiber)(same: projection.apply x = t) => At[x := x].slice (good x same);
\definition dense[U: \Pow P.Point][open: Sets.IsOpenIn P.space U][center: P.Point][inside: Sets.Member U center]:
  \exists ( t: P.Point \where Logic.And[Sets.Member U t, RegularParameter t] ) := \block {
  \takefrom t: \Cast[P.Point] ({ t: P.Point \where Logic.And[Sets.Member U t, Sard.Regular t] })
    \by Sard.regularDense U open center inside \then
  \let law: Logic.And[Sets.Member U t, Sard.Regular t] :=
    \bysub(P.Point, { t: P.Point \where Logic.And[Sets.Member U t, Sard.Regular t] }, t) \then
  \return Logic.existsIntro[P.Point, { t: P.Point \where Logic.And[Sets.Member U t, RegularParameter t] }]
    t (Logic.And[_, _]::# law.left (regularParameter t law.right))
};
