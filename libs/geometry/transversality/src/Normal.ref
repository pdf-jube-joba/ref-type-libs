\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Real.Algebra[].field] \as Spaces;
\module Between(V, W: \Set, source: Spaces.VectorSpace V, target: Spaces.VectorSpace W);
\module Derivative(V, W: \Set, source: Spaces.VectorSpace V, target: Spaces.VectorSpace W);
\module Through(V, W, Y: \Set, source: Spaces.VectorSpace V, intermediate: Spaces.VectorSpace W, values: Spaces.VectorSpace Y);
