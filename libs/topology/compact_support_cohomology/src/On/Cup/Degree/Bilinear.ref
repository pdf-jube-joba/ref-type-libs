\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Commutative;

\module AtSupports(K, L: Support) {
  \import \parent.\parent.\parent.AtSupports[K := K, L := L] \as Fixed;
  \import Fixed.Product[p := p, q := q] \as Native;
  \definition target: Modules.Bundle := Modules.Bundle {
    Carrier := Target.Stage (intersection K L), space := TargetModule.spaces (intersection K L),
  };
  \definition limit: Modules.Bundle := Modules.Bundle { Carrier := Target.Cohomology, space := TargetModule.moduleSpace };
  \import Commutative.Bilinear[A := Native.inputLeft, B := Native.inputRight, C := Native.output].Postcompose[D := target] \as Pull;
  \import Commutative.Bilinear[A := Native.inputLeft, B := Native.inputRight, C := target].Postcompose[D := limit] \as IntoLimit;
  \import Commutative.Bilinear[A := Native.inputLeft, B := Native.inputRight, C := limit] \as Map;
  \definition bilinear: Map.Map := IntoLimit.apply
    (Pull.apply Native.bilinear (Fixed.fromUnion outputDegree))
    (TargetModule.ofSupportLinear (intersection K L));
  \definition laws: Map.Laws[bilinear] := Map.laws bilinear;
}
\definition laws: Descent.Laws := Descent.Laws {
  addLeft := \fun (K, L: Support) => AtSupports[K := K, L := L].laws.addLeft,
  addRight := \fun (K, L: Support) => AtSupports[K := K, L := L].laws.addRight,
  scaleLeft := \fun (K, L: Support) => AtSupports[K := K, L := L].laws.scaleLeft,
  scaleRight := \fun (K, L: Support) => AtSupports[K := K, L := L].laws.scaleRight,
};
\import Descent.With[laws := laws] \as BilinearDescent;
\definition map: _ := BilinearDescent.bilinear;
