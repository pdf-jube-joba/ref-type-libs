\definition boundaryClosed: DiskSpace.IsClosedIn Disk.diskTopology Disk.Boundary :=
  Disk.Radial[].Boundary[].closed;
\definition Interior: \Pow Disk.DiskBundle := DiskSpace.Complement Disk.Boundary;
\module Radial;
\module Compare(diskCompact: DiskSpace.IsCompact Disk.diskTopology, diskHausdorff: DiskSpace.IsT2 Disk.diskTopology);
\module Finite(complex: algebraic_topology.CW[A := X].FiniteComplex[bundle.baseSpace]);
