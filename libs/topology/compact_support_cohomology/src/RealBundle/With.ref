\import thom_spaces.Thom[].Over[K := Real.Real, field := Real.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := Scalars.scalar]
  .For[X := X, F := F, bundle := bundle].With[metric := metric] \as Disk;
\import cohomology_thom.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric] \as C03;
\import topology.Topology[Carrier := Disk.DiskBundle] \as DiskSpace;
\import topology.Topology[Carrier := Family.Point] \as Total;
\import Total.Subspace[S := Disk.ClosedBall] \as DiskInTotal;
\import std.Logic[].Equality[] \as Equality;
