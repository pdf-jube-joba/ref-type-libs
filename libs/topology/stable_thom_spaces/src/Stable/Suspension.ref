\import puppe_sequences.Puppe[].Maps[A := A, B := B, source := source, target := target] \as Maps;
\import puppe_sequences.Puppe[].Suspension[A := A, source := source] \as Source;
\import puppe_sequences.Puppe[].Suspension[A := B, source := target] \as Target;
\import puppe_sequences.Puppe[].Maps[A := Source.Carrier, B := Target.Carrier, source := Source.pointed, target := Target.pointed] \as Suspended;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := A] \as SourceCylinder;
\import algebraic_topology.Cylinder[A := B] \as TargetCylinder;
\import algebraic_topology.Suspension[A := A].Reduced[basepoint := source.basepoint] \as Reduced;
\import algebraic_topology.Collapse[A := SourceCylinder.Carrier, subset := Reduced.Collapsed] \as Quotient;

\definition map[f: Maps.Map]: Suspended.Map := Source.Mapping[B := B, target := target, f := f].map;
\definition onPoint[f: Maps.Map][t: I.Carrier][x: A]:
  map f (Source.class (SourceCylinder.at t x)) = Target.class (TargetCylinder.at t (f x)) :=
  Source.Mapping[B := B, target := target, f := f].onClass (SourceCylinder.at t x);

\module Along(f, g: Maps.Map, h: Maps.Homotopy[f, g]);
\definition related[f, g: Maps.Map]: Maps.Related f g -> Suspended.Related (map f) (map g) := \block {
  \fun (related: Maps.Related f g) \then
  \takefrom h: Maps.Homotopy[f, g] \by related \then
  \return \exact(Along[f := f, g := g, h := h].homotopy, Suspended.Homotopy[map f, map g])
};
\import std.Set[].Quotient[A := Maps.Map, Equivalent := Maps.Related].Maps[B := Suspended.Class] \as Descent;
\definition classMap[f: Maps.Map]: Suspended.Class := Suspended.class (map f);
\definition respects[f, g: Maps.Map][same: Maps.Related f g]: classMap f = classMap g :=
  Suspended.equalOfHomotopic (map f) (map g) (related f g same);
\definition apply: Maps.Class -> Suspended.Class := Descent.value Maps.equivalence classMap respects;
\definition onClass: \forall (f: Maps.Map) -> apply (Maps.class f) = Suspended.class (map f) :=
  Descent.onClass Maps.equivalence classMap respects;
\definition constant: map Maps.constant = Suspended.constant :=
  Suspended.ext (map Maps.constant) Suspended.constant
    (Quotient.induction (\fun (q: Source.Carrier) => map Maps.constant q = Target.point)
      (\induction (p: SourceCylinder.Carrier) \return map Maps.constant (Source.class p) = Target.point \with {
        | pair: \fun (s: I.Carrier)(x: A) => trans!{Target.Carrier} _ _ _ (onPoint Maps.constant s x) (Target.line s)
      }));
\definition zero: apply Maps.zero = Suspended.zero :=
  trans!{Suspended.Class} _ _ _ (onClass Maps.constant)
    (congr!{Suspended.Map Suspended.Class} Suspended.class _ _ constant);
