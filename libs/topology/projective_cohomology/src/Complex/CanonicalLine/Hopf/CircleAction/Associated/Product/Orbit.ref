\import std.Logic[].Proposition[] \as Logic;
\structure Witness[p, q: Carrier]: \Set := {
  rotation: Circle.Carrier,
  frameLaw: frame q = action rotation (frame p),
  scalarLaw: scalar q = C.mul (Circle.inverse rotation) (scalar p)
};
\definition Related[p, q: Carrier]: \Prop := \exists Witness[p, q];
\definition sameBase[p, q: Carrier][same: evaluate p = evaluate q]: projection (frame p) = projection (frame q) :=
  congr!{{Family.Point} Space} Family.projection _ _ same;
\definition sameVector[p, q: Carrier][same: evaluate p = evaluate q]: evaluated (frame p) (scalar p) = evaluated (frame q) (scalar q) :=
  congr!{{Family.Point} {E.Vector}} (\fun (v: Family.Point) => v.vector) _ _ same;
\definition candidate[p, q: Carrier][same: evaluate p = evaluate q]: Circle.Carrier := orbit (frame p) (frame q) (sameBase p q same);
\definition scalarGeometry[p, q: Carrier][same: evaluate p = evaluate q]: scalar p = C.mul (scalar q) (candidate p q same) :=
  eq_reason_in!{Numbers.Complex _
    "=" _ "by" { sym!{Numbers.Complex} _ _ (scaledDot (frame p) (scalar p)) }
    "=" _ "by" { congr!{{E.Vector} {Numbers.Complex}} (E.dot (frame p)) _ _ (sameVector p q same) }
    "=" _ "by" { E.scaleRight (scalar q) (frame p) (frame q) }
  };
\definition scalarLaw[p, q: Carrier][same: evaluate p = evaluate q]: scalar q = C.mul (Circle.inverse (candidate p q same)) (scalar p) :=
  sym!{Numbers.Complex} _ _ (eq_reason_in!{Numbers.Complex _
    "=" _ "by" { congr!{Numbers.Complex Numbers.Complex} (C.mul (Circle.inverse (candidate p q same))) _ _ (scalarGeometry p q same) }
    "=" _ "by" { congr!{Numbers.Complex Numbers.Complex} (C.mul (Circle.inverse (candidate p q same))) _ _ (ComplexLaws.mulComm (scalar q) (candidate p q same)) }
    "=" _ "by" { sym!{Numbers.Complex} _ _ (ComplexLaws.mulAssoc (Circle.inverse (candidate p q same)) (candidate p q same) (scalar q)) }
    "=" _ "by" { congr!{Numbers.Complex Numbers.Complex} (\fun (a: Numbers.Complex) => C.mul a (scalar q)) _ _ (Circle.leftInverse (candidate p q same)) }
    "=" _ "by" { ComplexLaws.mulOneLeft (scalar q) }
  });
\definition related[p, q: Carrier][same: evaluate p = evaluate q]: Related p q := \exact(Witness[p, q] {
  rotation := candidate p q same,
  frameLaw := sym!{Sphere} _ _ (orbitLaw (frame p) (frame q) (sameBase p q same)),
  scalarLaw := scalarLaw p q same
}, Witness[p, q]);
\definition equal[p, q: Carrier][related: Related p q]: evaluate p = evaluate q := \block {
  \takefrom witness: Witness[p, q] \by related \then
  \return sym!{{Family.Point}} _ _ (trans!{{Family.Point}} _ _ _
    (congr!{Sphere Numbers.Complex {Family.Point}} tautological _ _ _ _ witness.frameLaw witness.scalarLaw)
    (tautologicalAction witness.rotation (frame p) (scalar p)))
};
