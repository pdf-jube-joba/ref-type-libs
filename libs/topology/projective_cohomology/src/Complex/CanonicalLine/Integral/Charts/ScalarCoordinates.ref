\import Numbers.Prop[] \as ComplexLaws;
\import sphere_maps.Circle[] \as Circle;
\import bundle_operations.Operations[].Scalars[] \as Scalars;
\import Scalars.RealCoordinates[n := Degrees.one] \as Coordinates;
\import std.Data[].FinSet[] \as Fin;
\definition index: Fin.Fin Degrees.one := Fin.zero N.Nat^::zero;
\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := Hermitian.Real[].scalar].Finite[n := Degrees.one] \as E;
\import E.Blocks[m := Degrees.one] \as Blocks;
\definition first[v: Bundles.Vector Degrees.one]: E.Vector := \fun (i: Fin.Fin Degrees.one) => Numbers.re (v i);
\definition second[v: Bundles.Vector Degrees.one]: E.Vector := \fun (i: Fin.Fin Degrees.one) => Numbers.im (v i);
\definition realCoordinates[v: Bundles.Vector Degrees.one]: Circle.Coordinates[].ambientForward (Coordinates.frame.forward.apply v) = v index :=
  ComplexLaws.ext _ _
    (congr!{{E.Vector} {R.Real}} (\fun (a: E.Vector) => a index) _ _ (Blocks.leftJoin (first v) (second v)))
    (congr!{{E.Vector} {R.Real}} (\fun (a: E.Vector) => a index) _ _ (Blocks.rightJoin (first v) (second v)));
