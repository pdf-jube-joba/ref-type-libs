\import Circle.Coordinates[] \as CircleCoordinates;
\import Circle.Translations[] \as Rotations;
\import algebraic_topology.PathComponent[A := Circle.Carrier, source := Circle.topology] \as Paths;
\import algebraic_topology.Homotopy[A := CircleCoordinates.Sphere, B := CircleCoordinates.Sphere] \as CircleHomotopies;
\import algebraic_topology.Homotopy[A := Source.SubspaceCarrier, B := CircleCoordinates.Sphere] \as SphereHomotopies;
\import algebraic_topology.Homotopy[A := Source.SubspaceCarrier, B := Target.SubspaceCarrier] \as Homotopies;
\definition turned[v: Source.SubspaceCarrier]: CircleCoordinates.Sphere := Rotations.apply Phase.unit (Old.direction v);
\definition directionLaw[v: Source.SubspaceCarrier]: New.direction v = turned v :=
  trans!{{CircleCoordinates.Sphere}} _ _ _ (sym!{{CircleCoordinates.Sphere}} _ _ (CircleCoordinates.leftInverse (New.direction v)))
    (congr!{{Circle.Carrier} {CircleCoordinates.Sphere}} CircleCoordinates.backward _ _ (boundaryRotation v));
\definition start[v: Source.SubspaceCarrier]: Target.SubspaceCarrier := PlaneDisk.boundaryPoint (Old.direction v);
\definition end[v: Source.SubspaceCarrier]: Target.SubspaceCarrier := PlaneDisk.boundaryPoint (turned v);
\definition endLaw[v: Source.SubspaceCarrier]: end v = NewMap.restriction v :=
  congr!{{CircleCoordinates.Sphere} {Target.SubspaceCarrier}} PlaneDisk.boundaryPoint _ _
    (sym!{{CircleCoordinates.Sphere}} _ _ (directionLaw v));
\definition homotopic: Homotopies.Homotopic[Old.boundaryTopology, PlaneDisk.boundaryTopology, OldMap.restriction, NewMap.restriction] := \block {
  \takefrom path: Paths.Path Circle.identity Phase.unit \by Rotations.connected Circle.identity Phase.unit \then
  \let onSphere: SphereHomotopies.Homotopy[Old.boundaryTopology, CircleCoordinates.sphereTopology, Old.direction, turned] :=
    CircleHomotopies.Composition[C := Source.SubspaceCarrier].precompose
      Old.boundaryTopology CircleCoordinates.sphereTopology CircleCoordinates.sphereTopology (\fun (v: CircleCoordinates.Sphere) => v)
      (Rotations.apply Phase.unit) (Rotations.homotopy Phase.unit path) Old.direction Old.directionContinuous \then
  \let h: Homotopies.Homotopy[Old.boundaryTopology, PlaneDisk.boundaryTopology, start, end] :=
    SphereHomotopies.Composition[C := Target.SubspaceCarrier].postcompose Old.boundaryTopology CircleCoordinates.sphereTopology PlaneDisk.boundaryTopology
      Old.direction turned onSphere PlaneDisk.boundaryPoint PlaneDisk.boundaryPointContinuous \then
  \let laws: Homotopies.Laws[Old.boundaryTopology, PlaneDisk.boundaryTopology, start, end, h] :=
    Homotopies.laws Old.boundaryTopology PlaneDisk.boundaryTopology start end h \then
  \return \exact(\into[Homotopies.Family](h, Homotopies.Homotopy[Old.boundaryTopology, PlaneDisk.boundaryTopology, OldMap.restriction, NewMap.restriction]) \by {
    Homotopies.Laws[Old.boundaryTopology, PlaneDisk.boundaryTopology, OldMap.restriction, NewMap.restriction, h] {
      continuous := laws.continuous,
      start := laws.start,
      end := \fun (v: Source.SubspaceCarrier) => trans!{{Target.SubspaceCarrier}} _ _ _ (laws.end v) (endLaw v)
    }
  }, Homotopies.Homotopy[Old.boundaryTopology, PlaneDisk.boundaryTopology, OldMap.restriction, NewMap.restriction])
};
\import singular_cohomology.Homotopy[A := Source.SubspaceCarrier, B := Target.SubspaceCarrier,
  source := Old.boundaryTopology, target := PlaneDisk.boundaryTopology].Coefficients[M := Product.integerCoefficients] \as HomotopyPull;
\import singular_cohomology.Maps[A := Source.SubspaceCarrier, B := Target.SubspaceCarrier, source := Old.boundaryTopology, target := PlaneDisk.boundaryTopology]
  .Coefficients[M := Product.integerCoefficients, L := Product.integerCoefficients] \as BoundaryPull;
\import Abelian.End[V := I.Int^, space := Product.integerCoefficients.space] \as Coefficients;
\import BoundaryPull.Integer[f := OldMap.restriction, continuous := OldMap.restrictionContinuous, coefficientMap := Coefficients.identity].At[n := Degrees.one] \as OldSigned;
\import BoundaryPull.Integer[f := NewMap.restriction, continuous := NewMap.restrictionContinuous, coefficientMap := Coefficients.identity].At[n := Degrees.one] \as NewSigned;
\import singular_cohomology.Cochains[A := Target.SubspaceCarrier, source := PlaneDisk.boundaryTopology].With[coefficients := Product.integerCoefficients].Integer[] \as TargetBoundary;
\import singular_cohomology.Cochains[A := Source.SubspaceCarrier, source := Old.boundaryTopology].With[coefficients := Product.integerCoefficients] \as NativeBoundary;
\definition pullLaw[u: TargetBoundary.cohomology degreeOne]: OldSigned.induced.apply u = NewSigned.induced.apply u := \block {
  \takefrom h: Homotopies.Homotopy[Old.boundaryTopology, PlaneDisk.boundaryTopology, OldMap.restriction, NewMap.restriction] \by homotopic \then
  \return eq_reason_in!{{SourceBoundary.cohomology degreeOne} _
    "=" _ "by" { sym!{{SourceBoundary.cohomology degreeOne}} _ _ (OldSigned.targetComparison.leftInverse (OldSigned.induced.apply u)) }
    "=" _ "by" { congr!{{NativeBoundary.cohomology Degrees.one} {SourceBoundary.cohomology degreeOne}}
      OldSigned.targetComparison.backward.apply _ _ (OldSigned.law u) }
    "=" _ "by" { congr!{{NativeBoundary.cohomology Degrees.one} {SourceBoundary.cohomology degreeOne}}
      OldSigned.targetComparison.backward.apply _ _
        (sym!{{NativeBoundary.cohomology Degrees.one}} _ _
          (HomotopyPull.onCohomology OldMap.restriction NewMap.restriction h Degrees.one (OldSigned.sourceComparison.forward.apply u))) }
    "=" _ "by" { congr!{{NativeBoundary.cohomology Degrees.one} {SourceBoundary.cohomology degreeOne}}
      OldSigned.targetComparison.backward.apply _ _ (sym!{{NativeBoundary.cohomology Degrees.one}} _ _ (NewSigned.law u)) }
    "=" _ "by" { NewSigned.targetComparison.leftInverse (NewSigned.induced.apply u) }
  }
};
