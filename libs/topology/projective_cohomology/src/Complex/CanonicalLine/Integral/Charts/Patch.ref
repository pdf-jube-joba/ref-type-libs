\import bundle_operations.Operations[].Scalars[] \as Scalars;
\import Scalars.Realification[X := Space, F := Line, source := lineBundle] \as Realify;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := Hermitian.Real[].scalar,
  scalar := vector_bundles.Bundles[].Real[].scalar].Family[X := Space, F := Line].With[data := Realification.bundle] \as RealCharts;
\definition nativeChart: Native.Chart := chart U Degrees.one frames;
\definition realChart: RealCharts.Chart := Realify.In[c := nativeChart].trivialization;
\definition realRank: realChart.dimension = Degrees.two := \refl(Degrees.two);
\import Geometry.Local[K := I.Int^, ring := Integers.commutativeRing] \as Local;
\import Local.Rank[n := Degrees.two] \as Rank;
\import Rank.On[U := U] \as On;
\import Local.Chart[c := realChart].Rank[n := Degrees.two, same := realRank] \as Model;
\definition class: _ := Model.model.thomClass;
\definition fiberClass[x: \Cast[Space] U]: Rank.FiberClass x := (On.restriction x).apply class;
\definition generates[x: \Cast[Space] U]: Rank.Fiber[x := x].Generator (fiberClass x) :=
  Model.Fiber[x := x].positive;
\module AtPoint(x: \Cast[Space] U);
