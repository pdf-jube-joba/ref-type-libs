\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import singular_cellular.On[A := Space, source := topology, complex := complex] \as Native;
\import \root.Cellular[X := Space, space := topology, complex := complex, K := algebra.Two[].Carrier, ring := algebra.Two[].commutativeRing] \as Cellular;
\module Degree(k: N.Nat^) {
  \import Native.Filtration[].CellInteriors[n := k] \as Interior;
  \definition Cell: \Set := Interior.Index;
  \definition emptyAbove: Order.Lt maximum k -> \forall (c: Cell) -> Logic.False :=
    \fun (above: Order.Lt maximum k)(c: Cell) => Order.ltNe maximum k above
      (Order.leAntisym maximum k (Order.leTrans maximum (N.Nat^::succ maximum) k (Order.leSelfSucc maximum) (Order.succLeOfLt k maximum above))
        (\idelim c.dimension = k \with j: N.Nat^ => Order.Le j maximum \by {
          base: cellBound c (Interior.member c), equality: Interior.dimension c
        }));
  \definition above: _ := \fun (bound: Order.Lt maximum k) => Cellular.Layer[n := k].singularZero (emptyAbove bound);
}
\import algebra.Two[] \as Two;
\import std.Data[].Bool[] \as B;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Abelian;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import singular_products.Cochains[A := Space, source := topology, R := Two.Carrier, ring := Two.commutativeRing] \as Product;
\import singular_cohomology.Cochains[A := Space, source := topology].With[coefficients := Product.integerCoefficients].Integer[] \as Groups;
\import Native.Cellular[].Representatives[] \as Representatives;
\module At(i: Fin.Fin ambient) {
  \import Native.Filtration[].CellInteriors[n := degree i] \as Interior;
  \definition point: Interior.Index := \into[CW.CellData](cell i, Interior.Selected) \by {
    Logic.And[_, _]::# (cellMember i) (cellDimension i)
  };
  \definition unique[c: Interior.Index]: c = point := cellAt i c (Interior.member c) (Interior.dimension c);
  \definition chainBasis: _ := Cellular.Layer[n := degree i].Singleton[cell := point, unique := unique].integerBasis;
  \definition z: I.Int^ := I.Int^::ofNat i;
  \import Cochains.At[C := Cellular.integerCochain, z := z] \as CellH;
  \import Cellular.Layer[n := i].Singleton[cell := point, unique := unique] \as Basis;
  \definition Raw: \Set := Cellular.integerCochain.family.Carrier z;
  \definition rawSpace: Abelian.Space Raw := Cellular.integerCochain.family.space z;
  \import Abelian.Hom[V := Raw, W := Two.Carrier, source := rawSpace, target := Cellular.coefficientSpace] \as Coordinate;
  \import Abelian.Hom[V := CellH.Closed, W := CellH.Cohomology, source := CellH.cycleSpace, target := CellH.cohomologySpace] \as Quotient;
  \import chain_complexes.Integer[] \as Integer;
  \module Coincide(x, y: CellH.Closed);
  \definition classify: \forall (x, y: CellH.Cohomology) -> Logic.Not (x = CellH.cohomologySpace.zero) ->
    Logic.Not (y = CellH.cohomologySpace.zero) -> x = y :=
    CellH.classInduction (\fun (x: CellH.Cohomology) => \forall (y: CellH.Cohomology) ->
      Logic.Not (x = CellH.cohomologySpace.zero) -> Logic.Not (y = CellH.cohomologySpace.zero) -> x = y)
      (\fun (x: CellH.Closed) => CellH.classInduction (\fun (y: CellH.Cohomology) =>
        Logic.Not (CellH.classOf x = CellH.cohomologySpace.zero) -> Logic.Not (y = CellH.cohomologySpace.zero) -> CellH.classOf x = y)
        (\fun (y: CellH.Closed)(xNonzero: _)(yNonzero: _) =>
          Coincide[x := x, y := y].law xNonzero yNonzero));
  \module Compared(selection: Representatives.Selection) {
    \definition comparison: _ := Cellular.With[selection := selection].Degree[z := z].comparison;
    \import Abelian.Hom[V := Groups.cohomology z, W := CellH.Cohomology, source := Groups.cohomologySpace z, target := CellH.cohomologySpace] \as ToCell;
    \definition nonzero[a: Groups.cohomology z]: Logic.Not (a = (Groups.cohomologySpace z).zero) ->
      Logic.Not (comparison.forward.apply a = CellH.cohomologySpace.zero) :=
      \fun (nonzero: _)(zero: _) => nonzero (trans!{{Groups.cohomology z}} _ _ _
        (sym!{{Groups.cohomology z}} _ _ (comparison.leftInverse a))
        (trans!{{Groups.cohomology z}} _ _ _
          (congr!{CellH.Cohomology {Groups.cohomology z}} comparison.backward.apply _ _
            (trans!{CellH.Cohomology} _ _ _ zero (sym!{CellH.Cohomology} _ _ (ToCell.zeroPreserved comparison.forward))))
          (comparison.leftInverse (Groups.cohomologySpace z).zero)));
    \definition uniqueNonzero[a, b: Groups.cohomology z]:
      Logic.Not (a = (Groups.cohomologySpace z).zero) -> Logic.Not (b = (Groups.cohomologySpace z).zero) -> a = b :=
      \fun (aNonzero: _)(bNonzero: _) => trans!{{Groups.cohomology z}} _ _ _
        (sym!{{Groups.cohomology z}} _ _ (comparison.leftInverse a))
        (trans!{{Groups.cohomology z}} _ _ _
          (congr!{CellH.Cohomology {Groups.cohomology z}} comparison.backward.apply _ _
            (classify (comparison.forward.apply a) (comparison.forward.apply b) (nonzero a aNonzero) (nonzero b bNonzero)))
          (comparison.leftInverse b));
  }
  \definition uniqueNonzero: \forall (a, b: Groups.cohomology z) ->
    Logic.Not (a = (Groups.cohomologySpace z).zero) -> Logic.Not (b = (Groups.cohomologySpace z).zero) -> a = b := \block {
      \fun (a, b: Groups.cohomology z)(aNonzero: _)(bNonzero: _) \then
      \takefrom selection: Representatives.Selection \by Cellular.representativesExist \then
      \return Compared[selection := selection].uniqueNonzero a b aNonzero bNonzero
    };

}
