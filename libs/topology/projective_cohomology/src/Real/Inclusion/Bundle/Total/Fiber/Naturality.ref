\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Proposition[] \as Logic;
\definition z: I.Int^ := I.Int^::ofNat Degrees.one;
\import Old.Additive[coefficients := OldProduct.integerCoefficients, z := z] \as OldGroup;
\import New.Additive[coefficients := OldProduct.integerCoefficients, z := z] \as NewGroup;
\import cohomology_thom.RelativePullback[].On[A := Old.Carrier, source := Old.topology, subset := Old.boundary, R := Two.Carrier, ring := Two.commutativeRing]
  .To[B := New.Carrier, target := New.topology, part := New.boundary].Homeomorphism[data := comparison].Degree[n := Degrees.one] \as Iso;
\import cohomology_thom.RelativePullback[].On[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := Two.Carrier, ring := Two.commutativeRing]
  .To[B := TargetDisk.DiskBundle, target := TargetDisk.diskTopology, part := TargetDisk.Boundary].Along[f := pairMap].Degree[n := Degrees.one] \as Pull;
\import singular_cohomology.Relative[A := Old.Carrier, source := Old.topology, subset := Old.boundary]
  .Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary]
  .Composition[C := TargetDisk.DiskBundle].Over[final := TargetDisk.diskTopology, finalSubset := TargetDisk.Boundary] \as First;
\import singular_cohomology.Relative[A := Old.Carrier, source := Old.topology, subset := Old.boundary]
  .Maps[B := New.Carrier].Over[target := New.topology, targetSubset := New.boundary]
  .Composition[C := TargetDisk.DiskBundle].Over[final := TargetDisk.diskTopology, finalSubset := TargetDisk.Boundary] \as Second;
\import singular_cohomology.Relative[A := Old.Carrier, source := Old.topology, subset := Old.boundary]
  .Maps[B := TargetDisk.DiskBundle].Over[target := TargetDisk.diskTopology, targetSubset := TargetDisk.Boundary] \as Direct;
\definition fiberMap: _ := Pairs.forwardMap comparison;
\definition same: First.compose Old.pairInclusion pairMap = Second.compose fiberMap New.pairInclusion :=
  \refl(First.compose Old.pairInclusion pairMap);
\definition direct[f: Direct.Map]: _ := Direct.On[f := f].Integer[].With[coefficients := OldProduct.integerCoefficients].At[z := z].induced;
\definition restrict[u: NewRelative.Class]: OldGroup.restriction.apply (Pull.map.apply u) = Iso.isomorphism.forward.apply (NewGroup.restriction.apply u) :=
  trans!{{OldGroup.Class}} _ _ _
    (sym!{{OldGroup.Class}} _ _ (First.On[f := Old.pairInclusion, g := pairMap].With[coefficients := OldProduct.integerCoefficients].law z u))
    (trans!{{OldGroup.Class}} _ _ _
      (congr!{{Direct.Map} {OldGroup.Class}} (\fun (f: Direct.Map) => (direct f).apply u) _ _ same)
      (Second.On[f := fiberMap, g := New.pairInclusion].With[coefficients := OldProduct.integerCoefficients].law z u));
\import std.Alg[].Ring[] \as Rings;
\import module_theory.Module[].Over[R := Two.Carrier, ring := Rings.commutativeRingAsRing Two.Carrier Two.commutativeRing] \as Modules;
\import OldGeometry.Local[K := Two.Carrier, ring := Two.commutativeRing].Rank[n := Degrees.one].Fiber[x := x] \as OldFiber;
\import NewGeometry.Local[K := Two.Carrier, ring := Two.commutativeRing].Rank[n := Degrees.one].Fiber[x := map x] \as NewFiber;
\import Modules.Isomorphism[V := Two.Carrier, W := NewGroup.Class, source := Modules.scalarModule, target := NewFiber.space] \as NewModels;
\import Modules.Isomorphism[V := Two.Carrier, W := OldGroup.Class, source := Modules.scalarModule, target := OldFiber.space] \as OldModels;
\import NewModels.Composition[U := OldGroup.Class, final := OldFiber.space] \as Compose;
\definition generates[u: NewRelative.Class]: NewFiber.Generator (NewGroup.restriction.apply u) ->
  OldFiber.Generator (OldGroup.restriction.apply (Pull.map.apply u)) := \block {
  \fun (positive: _) \then
  \takefrom model: \Cast[NewModels.Isomorphism] ({ e: NewModels.Isomorphism \where
    e.forward.apply Two.one = NewGroup.restriction.apply u }) \by positive \then
  \let transported: OldModels.Isomorphism := Compose.compose Iso.isomorphism model \then
  \return Logic.existsIntro[OldModels.Isomorphism, { e: OldModels.Isomorphism \where
    e.forward.apply Two.one = OldGroup.restriction.apply (Pull.map.apply u) }] transported
    (trans!{{OldGroup.Class}} _ _ _
      (congr!{{NewGroup.Class} {OldGroup.Class}} Iso.isomorphism.forward.apply _ _
        (\bysub(NewModels.Isomorphism, { e: NewModels.Isomorphism \where
          e.forward.apply Two.one = NewGroup.restriction.apply u }, model)))
      (sym!{{OldGroup.Class}} _ _ (restrict u)))
};
