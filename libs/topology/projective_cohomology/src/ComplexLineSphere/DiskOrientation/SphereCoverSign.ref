\import std.Data[].Nat[] \as N;
\import cohomology_models.SphereCover[n := n] \as Model;
\import Spheres.Positive[n := n] \as Geometry;
\definition upper: N.Nat^ := N.Nat^::succ n;
\definition Sphere: \Set := Spheres.Carrier upper;
\definition source: topology.Topology[Carrier := Sphere].Topology := Spheres.topology upper;
\import singular_products.Cochains[A := Sphere, source := source, R := I.Int^, ring := Integers.commutativeRing] \as Product;
\definition coefficients: Modules.Bundle := Product.integerCoefficients;
\import singular_excision.MayerVietoris[A := Sphere].Over[source := source].On[cover := Model.cover] \as Cover;
\import Cover.Chains[] \as ChainsCover;
\import ChainsCover.With[coefficients := coefficients] \as Middle;
\import ChainsCover.Cohomology[coefficients := coefficients] \as Comparison;
\import Cover.Reduced[] \as Reduced;
\import singular_cohomology.Relative[A := Geometry.Left, source := Geometry.leftTopology, subset := Geometry.intersection] \as LeftPair;
\import singular_cohomology.Relative[A := Sphere, source := source, subset := Geometry.right] \as WholePair;
\import LeftPair.With[coefficients := coefficients] \as LeftRelative;
\import LeftRelative.PairSequence[] \as LeftExact;
\import WholePair.With[coefficients := coefficients] \as WholeRelative;
\import WholeRelative.PairSequence[] \as WholeExact;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import singular_cohomology.Chains[A := Geometry.Left, source := Geometry.leftTopology] \as LeftChains;
\import singular_cohomology.Chains[A := Geometry.Right, source := Geometry.rightTopology] \as RightChains;
\import singular_cohomology.Chains[A := Geometry.Intersection, source := Geometry.intersectionTopology] \as OverlapChains;
\import singular_cohomology.Chains[A := Sphere, source := source] \as WholeChains;
\import singular_subdivision.Small[A := Sphere, source := source, family := Cover.family] \as SmallChains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := LeftChains.complex] \as LeftExtension;
\import Nonnegative.ZeroExtension[C := RightChains.complex] \as RightExtension;
\import Hom.Integer[P := LeftExtension.complex, N := coefficients] \as LeftHom;
\import Hom.Integer[P := RightExtension.complex, N := coefficients] \as RightHom;
\import SmallChains.FromSubset[U := ChainsCover.leftElement] \as SmallFromLeft;
\import SmallChains.FromSubset[U := ChainsCover.rightElement] \as SmallFromRight;
\import Nonnegative.ZeroExtension[C := SmallChains.complex] \as SmallExtension;
\import Nonnegative.ZeroExtension[C := WholeChains.complex] \as WholeExtension;
\import Nonnegative.ZeroExtension[C := OverlapChains.complex] \as OverlapExtension;
\import Hom.Integer[P := SmallExtension.complex, N := coefficients] \as SmallHom;
\import Hom.Integer[P := WholeExtension.complex, N := coefficients] \as WholeHom;
\import Hom.Integer[P := OverlapExtension.complex, N := coefficients] \as IntersectionHom;
\import Nonnegative.Biproduct[C := LeftChains.complex, D := RightChains.complex] \as ChainsSum;
\import Nonnegative.ZeroExtension[C := ChainsSum.complex] \as SumExtension;
\import Hom.Integer[P := SumExtension.complex, N := coefficients] \as SumHom;
\import Hom.Biproduct[P := LeftChains.complex, Q := RightChains.complex, N := coefficients] \as Sum;
\import \parent.ExtensionByZero[A := LeftRelative.complex, B := LeftHom.complex, C := IntersectionHom.complex,
  A1 := SmallHom.complex, B1 := SumHom.complex] \as Extend;
\import Extend.Along[s := LeftExact.sequence, t := Middle.sequence, b := Sum.firstInjection] \as ThroughLeft;
\module Projection;
\import ThroughLeft.With[right := Projection[].law] \as Supported;
\module Cut;
\module CohomologyLaw;
