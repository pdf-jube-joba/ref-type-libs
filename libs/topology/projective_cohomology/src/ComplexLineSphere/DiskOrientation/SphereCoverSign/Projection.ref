\import Nonnegative.Map[C := OverlapChains.complex, D := ChainsSum.complex].ZeroExtension[f := ChainsCover.inclusion] \as IntoSum;
\import Nonnegative.Map[C := ChainsSum.complex, D := LeftChains.complex].ZeroExtension[f := ChainsSum.firstProjection] \as FromSum;
\definition positive[k: N.Nat^][v: OverlapExtension.Carrier (I.Int^::ofNat k)]:
  FromSum.map.apply (I.Int^::ofNat k) (IntoSum.map.apply (I.Int^::ofNat k) v) = LeftPair.inclusionMap.apply (I.Int^::ofNat k) v :=
  \refl(LeftExtension.Positive[n := k].intro (ChainsCover.leftMap.apply k v));
\definition chainLaw: \forall (z: I.Int^)(v: OverlapExtension.Carrier z) ->
  FromSum.map.apply z (IntoSum.map.apply z v) = LeftPair.inclusionMap.apply z v :=
  \induction (z: I.Int^) \return \forall (v: OverlapExtension.Carrier z) ->
    FromSum.map.apply z (IntoSum.map.apply z v) = LeftPair.inclusionMap.apply z v \with {
    | ofNat: \fun (k: N.Nat^) => positive k
    | negSucc: \fun (k: N.Nat^)(v: OverlapExtension.Carrier (I.Int^::negSucc k)) => \refl((LeftExtension.space (I.Int^::negSucc k)).zero)
  };
\definition throughSum[z: I.Int^][x: LeftHom.Carrier z]: IntersectionHom.Carrier z := Middle.sequence.projection.apply z (Sum.firstInjection.apply z x);
\definition direct[z: I.Int^][x: LeftHom.Carrier z]: IntersectionHom.Carrier z := LeftExact.sequence.projection.apply z x;
\definition law[z: I.Int^][x: LeftHom.Carrier z]: throughSum z x = direct z x :=
  IntersectionHom.At[z := z].ext (throughSum z x) (direct z x)
    (\fun (v: OverlapExtension.Carrier z) => congr!{{LeftExtension.Carrier z} I.Int^} x.apply _ _ (chainLaw z v));
