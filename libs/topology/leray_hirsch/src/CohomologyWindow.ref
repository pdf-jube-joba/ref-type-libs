\import std.Arithmetic[].Int[] \as I;
\import chain_complexes.Integer[] \as Degrees;
\import Degrees.Over[R := K, ring := ring] \as Cochains;
\import module_theory.Module[].Over[R := K, ring := ring] \as Modules;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason_in;
\module Of(C, D: Cochains.Complex) {
  \import Cochains.Map[C := C, D := D] \as Maps;
  \module At(f: Maps.Map, z: I.Int^);
}
