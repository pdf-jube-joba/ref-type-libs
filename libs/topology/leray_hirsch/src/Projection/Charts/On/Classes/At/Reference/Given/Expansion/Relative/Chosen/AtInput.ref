\import N.Basic[].Prop[] \as Nat;
\import N.Order[].Prop[] \as Order;
\import std.Logic[].Order[] \as O;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason_in;
\import Modules.Sums[I := Index].Vector[V := Standard.range.Carrier, space := Standard.range.space] \as Sums;
\definition coefficient[i, j: Index]: StandardDirect.family.Carrier j := cells i j;
\module Column(i: Index);
\module Row(j: Index);
\definition vector[j: Index]: StandardDirect.family.Carrier j := Row[j := j].value;
\definition term[i, j: Index]: Standard.range.Carrier := (StandardDirect.components j).apply (coefficient i j);
\definition expanded: comparison.forward.apply vector = Actual.finite.apply x :=
  eq_reason_in!{{Standard.range.Carrier} _
    "=" _ "by" { Sums.congruent (Finite.elements count)
      (\fun (j: Index) => (StandardDirect.components j).apply (vector j))
      (\fun (j: Index) => Sums.sum (Finite.elements count) (\fun (i: Index) => term i j))
      (\fun (j: Index) => Row[j := j].onImage) }
    "=" _ "by" { Sums.exchange (Finite.elements count) (Finite.elements count) (\fun (j, i: Index) => term i j) }
    "=" _ "by" { Sums.congruent (Finite.elements count)
      (\fun (i: Index) => Sums.sum (Finite.elements count) (term i))
      (\fun (i: Index) => (ActualDirect.components i).apply (x i))
      (\fun (i: Index) => Column[i := i].law) }
  };
\definition normalize: normalized.apply x = vector :=
  trans!{{Standard.domain.Carrier}} _ _ _
    (congr!{{Standard.range.Carrier} {Standard.domain.Carrier}} comparison.backward.apply _ _
      (sym!{{Standard.range.Carrier}} _ _ expanded))
    (comparison.leftInverse vector);

\module Leading(j: Index);
