\import std.Logic[].Proposition[] \as Logic;
\import std.Set[].FiniteSubset[A := \Pow X] \as Finite;
\definition IsChart[U: \Pow X]: \Prop := Logic.And[Base.IsOpenIn base U, \exists \parent.On[U := U].Chart];
\definition family: \Pow (\Pow X) := { U: \Pow X \where IsChart U };
\definition cover: Base.IsOpenCover[base, family, Base.Whole] := Base.IsOpenCover[base, family, Base.Whole] {
  open := \fun (U: \Pow X)(member: Base.FamilyMember family U) => member.left,
  covers := \block {
    \fun (x: X)(inside: Base.Member Base.Whole x) \then
    \takefrom U: \Cast[\Pow X] ({ U: \Pow X \where Logic.And[Base.Member U x, IsChart U] }) \by trivial x \then
    \let witness: Logic.And[Base.Member U x, IsChart U] :=
      \bysub(\Pow X, { V: \Pow X \where Logic.And[Base.Member V x, IsChart V] }, U) \then
    \return Base.unionMemberOf family U x witness.right witness.left
  },
};
\definition finite[complex: algebraic_topology.CW[A := X].FiniteComplex[base]]:
  \exists ( domains: Finite.FiniteSubset \where Base.FiniteSubcover[family, Base.Whole, domains] ) :=
  thom_spaces.Thom[].CWType[].CompactType[A := X, source := base].Native[complex := complex].compact family cover;

\module Induction(P: \Pow X -> \Prop);
