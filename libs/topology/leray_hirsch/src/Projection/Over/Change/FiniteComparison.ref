\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Z;
\import TotalPair.With[coefficients := TotalProduct.integerCoefficients] \as OldInteger;
\import singular_products.Cochains[A := E, source := total, R := L, ring := targetRing] \as NewTotalProduct;
\import TotalPair.With[coefficients := NewTotalProduct.integerCoefficients] \as NewInteger;
\definition Index: \Set := Finite.Fin count;
\definition newClasses[i: Index]: NewTotalProduct.Cohomology[].Group (degree i) := (TargetCoefficients.absolute (degree i)).apply (classes i);
\import \parent.\parent.Comparison[count := count].With[degree := degree, classes := classes] \as Source;
\import New.Comparison[count := count].With[degree := degree, classes := newClasses] \as Target;
\module At(z: I.Int^) {
  \import Source.At[z := z] \as Input;
  \import Target.At[z := z] \as Output;
  \import Input.ProductCoordinates[] \as InputCoordinates;
  \import Output.ProductCoordinates[] \as OutputCoordinates;
  \definition coordinates[x: InputCoordinates.domain.Carrier][i: Index]: Output.family.Carrier i :=
    (SourceCoefficients.relative (Input.inputDegree i)).apply (x i);
  \import Z.Sums[I := Index].Vector[V := InputCoordinates.range.Carrier, space := OldInteger.At[z := z].space]
    .Mapping[W := OutputCoordinates.range.Carrier, target := NewInteger.At[z := z].space] \as Sums;
  \import Z.Sums[I := Index].Vector[V := OutputCoordinates.range.Carrier, space := NewInteger.At[z := z].space] \as Result;
  \definition onInput: \forall (i: Index)(a: Input.family.Carrier i) ->
    (TargetCoefficients.relative z).apply ((Input.components i).apply a) =
    (Output.components i).apply ((SourceCoefficients.relative (Input.inputDegree i)).apply a) :=
    \fun (i: Index) => \parent.\parent.Shift[q := degree i, u := classes i].At[z := z].law;
  \definition productLaw: \forall (x: InputCoordinates.domain.Carrier) ->
    (TargetCoefficients.relative z).apply (InputCoordinates.finite.apply x) = OutputCoordinates.finite.apply (coordinates x) :=
    \fun (x: InputCoordinates.domain.Carrier) => trans!{{OutputCoordinates.range.Carrier}} _ _ _
      (Sums.law (TargetCoefficients.relative z) (Finite.elements count) (\fun (i: Index) => (Input.components i).apply (x i)))
      (Result.congruent (Finite.elements count)
        (\fun (i: Index) => (TargetCoefficients.relative z).apply ((Input.components i).apply (x i)))
        (\fun (i: Index) => (Output.components i).apply (coordinates x i))
        (\fun (i: Index) => onInput i (x i)));
  \import module_theory.Module[].Over[R := L, ring := std.Alg[].Ring[].commutativeRingAsRing L targetRing] \as NewModules;
  \import Modules.DirectSum[Index := Index, family := Input.family] \as InputSum;
  \import NewModules.DirectSum[Index := Index, family := Output.family] \as OutputSum;
  \definition map[a: InputSum.Carrier]: OutputSum.Carrier :=
    Output.coordinateIsomorphism.backward.apply (coordinates (Input.coordinates.apply a));
  \definition law: \forall (a: InputSum.Carrier) ->
    (TargetCoefficients.relative z).apply (Input.linear.apply a) = Output.linear.apply (map a) :=
    \fun (a: InputSum.Carrier) => trans!{{OutputCoordinates.range.Carrier}} _ _ _
      (congr!{{InputCoordinates.range.Carrier} {OutputCoordinates.range.Carrier}} (TargetCoefficients.relative z).apply _ _ (InputCoordinates.onCoordinates a))
      (trans!{{OutputCoordinates.range.Carrier}} _ _ _
        (productLaw (Input.coordinates.apply a))
        (sym!{{OutputCoordinates.range.Carrier}} _ _ (OutputCoordinates.formula (coordinates (Input.coordinates.apply a)))));
}
