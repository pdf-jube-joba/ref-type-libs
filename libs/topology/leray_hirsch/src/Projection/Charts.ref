\import std.Data[].Pair[] \as Pair;
\module On(U: \Pow X) {
  \import Base.Subspace[S := U] \as LocalBase;
  \import Total.Subspace[S := preimage U] \as LocalTotal;
  \import topological_constructions.Product[A := LocalBase.CarrierSet, B := F] \as Product;
  \definition chartTarget: Product.ProductTopology := Product.topology (LocalBase.topology base) fiber;
  \definition basePoint[p: Product.CarrierSet]: X := Pair.first LocalBase.CarrierSet F p;
  \structure Chart: \Set := {
    coordinates: topology.Homeomorphism[A := LocalTotal.CarrierSet, B := Product.CarrierSet].Homeomorphism[LocalTotal.topology total, chartTarget],
    overBase: \forall (e: LocalTotal.CarrierSet) ->
      basePoint (coordinates.forward e) = projection e,
  };
  \module Restriction(V: \Pow X, contained: Base.Subset V U, chart: Chart);
  \module Fiber(x: X, belongs: Base.Member U x, chart: Chart);
  \module Classes(chart: Chart, K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K], count: std.Data[].Nat[].Nat^,
    degree: std.Data[].FinSet[].Fin count -> std.Data[].Nat[].Nat^,
    classes: \forall (i: std.Data[].FinSet[].Fin count) -> singular_products.Cochains[A := E, source := total, R := K, ring := ring].Cohomology[].Group (degree i));
  \module Paired(subset: \Pow X, chart: Chart);
}
\definition LocallyTrivial: \Prop := \forall (x: X) ->
  \exists ( U: \Pow X \where std.Logic[].Proposition[].And[Base.Member U x,
    std.Logic[].Proposition[].And[Base.IsOpenIn base U, \exists On[U := U].Chart]] );
\module Cover(trivial: LocallyTrivial);
