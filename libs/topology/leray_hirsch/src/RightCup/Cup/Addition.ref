\use std.Logic[].Equality[].eq_reason_in;
\import \parent.SumAction[] \as Components;
\import Modules.Laws[V := SmallHom.Carrier outputDegree, space := SmallHom.space outputDegree] \as TargetLaws;
\import algebra.Group[].Of[Carrier := SmallHom.Carrier outputDegree, group := TargetLaws.additive] \as TargetGroup;
\import Modules.Laws[V := SmallHom.Carrier inputDegree, space := SmallHom.space inputDegree] \as SourceLaws;
\import algebra.Group[].Of[Carrier := SmallHom.Carrier inputDegree, group := SourceLaws.additive] \as SourceGroup;
\definition leftAddition: \forall (u: Factor)(h, k: SumHom.Carrier inputDegree) -> sumLeft u ((SumHom.space inputDegree).add h k) = (LeftHom.space outputDegree).add (sumLeft u h) (sumLeft u k) :=
  \fun (u: Factor)(h, k: SumHom.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{LeftHom.Carrier inputDegree} {LeftHom.Carrier outputDegree}} (\fun (a: LeftHom.Carrier inputDegree) => LP.left (a) (Restriction.left u)) _ _ (Coordinates.firstProjection.addition inputDegree h k) }
    "=" _ "by" { LP.Bilinear[].leftLeftAdd ((Coordinates.firstProjection.apply inputDegree h)) ((Coordinates.firstProjection.apply inputDegree k)) (Restriction.left u) }
  };
\definition leftSum: \forall (u: Factor)(h, k: SumHom.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (sumAction u ((SumHom.space inputDegree).add h k)) = Coordinates.firstProjection.apply outputDegree ((SumHom.space outputDegree).add (sumAction u h) (sumAction u k)) :=
  \fun (u: Factor)(h, k: SumHom.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier outputDegree} _
    "=" _ "by" { Components.left u ((SumHom.space inputDegree).add h k) }
    "=" _ "by" { leftAddition u h k }
    "=" _ "by" { congr!{{LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} (LeftHom.space outputDegree).add _ _ _ _ (sym!{{LeftHom.Carrier outputDegree}} _ _ (Components.left u h)) (sym!{{LeftHom.Carrier outputDegree}} _ _ (Components.left u k)) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (Coordinates.firstProjection.addition outputDegree (sumAction u h) (sumAction u k)) }
  };
\definition rightAddition: \forall (u: Factor)(h, k: SumHom.Carrier inputDegree) -> sumRight u ((SumHom.space inputDegree).add h k) = (RightHom.space outputDegree).add (sumRight u h) (sumRight u k) :=
  \fun (u: Factor)(h, k: SumHom.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{RightHom.Carrier inputDegree} {RightHom.Carrier outputDegree}} (\fun (a: RightHom.Carrier inputDegree) => RP.left (a) (Restriction.right u)) _ _ (Coordinates.secondProjection.addition inputDegree h k) }
    "=" _ "by" { RP.Bilinear[].leftLeftAdd ((Coordinates.secondProjection.apply inputDegree h)) ((Coordinates.secondProjection.apply inputDegree k)) (Restriction.right u) }
  };
\definition rightSum: \forall (u: Factor)(h, k: SumHom.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (sumAction u ((SumHom.space inputDegree).add h k)) = Coordinates.secondProjection.apply outputDegree ((SumHom.space outputDegree).add (sumAction u h) (sumAction u k)) :=
  \fun (u: Factor)(h, k: SumHom.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier outputDegree} _
    "=" _ "by" { Components.right u ((SumHom.space inputDegree).add h k) }
    "=" _ "by" { rightAddition u h k }
    "=" _ "by" { congr!{{RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} (RightHom.space outputDegree).add _ _ _ _ (sym!{{RightHom.Carrier outputDegree}} _ _ (Components.right u h)) (sym!{{RightHom.Carrier outputDegree}} _ _ (Components.right u k)) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (Coordinates.secondProjection.addition outputDegree (sumAction u h) (sumAction u k)) }
  };
\definition sumAddition: \forall (u: Factor)(h, k: SumHom.Carrier inputDegree) -> sumAction u ((SumHom.space inputDegree).add h k) = (SumHom.space outputDegree).add (sumAction u h) (sumAction u k) :=
  \fun (u: Factor)(h, k: SumHom.Carrier inputDegree) => Coordinates.ext outputDegree _ _ (leftSum u h k) (rightSum u h k);
\definition law: \forall (u: Factor)(h, k: SmallHom.Carrier inputDegree) -> apply u ((SmallHom.space inputDegree).add h k) = (SmallHom.space outputDegree).add (apply u h) (apply u k) :=
  \fun (u: Factor)(h, k: SmallHom.Carrier inputDegree) => MV.sequence.injective outputDegree _ _ (eq_reason_in!{{SumHom.Carrier outputDegree} _
    "=" _ "by" { inclusion u ((SmallHom.space inputDegree).add h k) }
    "=" _ "by" { congr!{{SumHom.Carrier inputDegree} {SumHom.Carrier outputDegree}} (sumAction u) _ _ (MV.sequence.inclusion.addition inputDegree h k) }
    "=" _ "by" { sumAddition u (MV.sequence.inclusion.apply inputDegree h) (MV.sequence.inclusion.apply inputDegree k) }
    "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {SumHom.Carrier outputDegree} {SumHom.Carrier outputDegree}} (SumHom.space outputDegree).add _ _ _ _ (sym!{{SumHom.Carrier outputDegree}} _ _ (inclusion u h)) (sym!{{SumHom.Carrier outputDegree}} _ _ (inclusion u k)) }
    "=" _ "by" { sym!{{SumHom.Carrier outputDegree}} _ _ (MV.sequence.inclusion.addition outputDegree (apply u h) (apply u k)) }
  });
\definition zero: \forall (u: Factor) -> apply u (SmallHom.space inputDegree).zero = (SmallHom.space outputDegree).zero :=
  \fun (u: Factor) => sym!{{SmallHom.Carrier outputDegree}} _ _
    (TargetGroup.cancelLeft (apply u SourceGroup.zero) TargetGroup.zero (apply u SourceGroup.zero)
      (trans!{{SmallHom.Carrier outputDegree}} _ _ _ (TargetGroup.zeroRight (apply u SourceGroup.zero))
        (trans!{{SmallHom.Carrier outputDegree}} _ _ _
          (sym!{{SmallHom.Carrier outputDegree}} _ _ (congr!{{SmallHom.Carrier inputDegree} {SmallHom.Carrier outputDegree}} (\fun (h: SmallHom.Carrier inputDegree) => apply u h) _ _ (SourceGroup.zeroLeft SourceGroup.zero)))
          (law u SourceGroup.zero SourceGroup.zero))));
\definition negative: \forall (u: Factor)(h: SmallHom.Carrier inputDegree) -> apply u (SourceGroup.neg h) = TargetGroup.neg (apply u h) :=
  \fun (u: Factor)(h: SmallHom.Carrier inputDegree) => TargetGroup.inverseUnique (apply u h) (apply u (SourceGroup.neg h))
    (eq_reason_in!{{SmallHom.Carrier outputDegree} _
      "=" _ "by" { sym!{{SmallHom.Carrier outputDegree}} _ _ (law u (SourceGroup.neg h) h) }
      "=" _ "by" { congr!{{SmallHom.Carrier inputDegree} {SmallHom.Carrier outputDegree}} (\fun (v: SmallHom.Carrier inputDegree) => apply u v) _ _ (SourceGroup.inverseLeft h) }
      "=" _ "by" { zero u }
    });
\definition difference: \forall (u: Factor)(h, k: SmallHom.Carrier inputDegree) -> apply u (SourceGroup.difference h k) = TargetGroup.difference (apply u h) (apply u k) :=
  \fun (u: Factor)(h, k: SmallHom.Carrier inputDegree) => trans!{{SmallHom.Carrier outputDegree}} _ _ _ (law u h (SourceGroup.neg k))
    (congr!{{SmallHom.Carrier outputDegree} {SmallHom.Carrier outputDegree}} (TargetGroup.add (apply u h)) _ _ (negative u k));
