\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_excision.MayerVietoris[A := A].Over[source := source].On[cover := cover] \as Cover;
\import cohomology_thom.RelativeMayerVietoris[].OpenCover[A := A, source := source, subset := subset].On[cover := cover] \as Geometry;
\definition Left: \Set := Geometry.Left;
\definition Right: \Set := Geometry.Right;
\definition Overlap: \Set := Geometry.Overlap;
\definition leftTopology: _ := Geometry.leftTopology;
\definition rightTopology: _ := Geometry.rightTopology;
\definition overlapTopology: _ := Geometry.overlapTopology;
\definition leftPart: \Pow Left := Geometry.leftPart;
\definition rightPart: \Pow Right := Geometry.rightPart;
\definition overlapPart: \Pow Overlap := Geometry.overlapPart;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as W;
\import singular_cohomology.Relative[A := Left, source := leftTopology, subset := leftPart] \as L;
\import singular_cohomology.Relative[A := Right, source := rightTopology, subset := rightPart] \as R;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapPart] \as O;
\import cohomology_thom.RelativeMayerVietoris[].ChainSum[C := L.complex, D := R.complex] \as Sum;
\import cohomology_thom.RelativeMayerVietoris[].SmallPair[A := A, source := source, cover := Cover.openCover, subset := subset] \as SmallPair;
\use std.Logic[].Equality[].eq_reason_in;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as WholeProduct;
\import singular_products.Cochains[A := Left, source := leftTopology, R := K, ring := ring] \as LeftProduct;
\import singular_products.Cochains[A := Right, source := rightTopology, R := K, ring := ring] \as RightProduct;
\import singular_products.Cochains[A := Overlap, source := overlapTopology, R := K, ring := ring] \as OverlapProduct;
\import singular_cap.CochainPair[A := A, source := source, subset := subset, R := K, ring := ring] \as WholeCup;
\import singular_cap.CochainPair[A := Left, source := leftTopology, subset := leftPart, R := K, ring := ring] \as LeftCup;
\import singular_cap.CochainPair[A := Right, source := rightTopology, subset := rightPart, R := K, ring := ring] \as RightCup;
\import singular_cap.CochainPair[A := Overlap, source := overlapTopology, subset := overlapPart, R := K, ring := ring] \as OverlapCup;
\import Geometry.With[coefficients := WholeProduct.integerCoefficients] \as MV;
\import cohomology_thom.RelativeMayerVietoris[].HomSum[C := L.complex, D := R.complex, coefficients := WholeProduct.integerCoefficients] \as Coordinates;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := SmallPair.complex, N := WholeProduct.integerCoefficients] \as SmallHom;
\import Hom.Integer[P := Sum.complex, N := WholeProduct.integerCoefficients] \as SumHom;
\import Hom.Integer[P := L.complex, N := WholeProduct.integerCoefficients] \as LeftHom;
\import Hom.Integer[P := R.complex, N := WholeProduct.integerCoefficients] \as RightHom;
\import Hom.Integer[P := O.complex, N := WholeProduct.integerCoefficients] \as OverlapHom;
\import LeftProduct.Pullback[B := A, target := source] \as WholeToLeft;
\import RightProduct.Pullback[B := A, target := source] \as WholeToRight;
\import OverlapProduct.Pullback[B := Left, target := leftTopology] \as LeftToOverlap;
\import OverlapProduct.Pullback[B := Right, target := rightTopology] \as RightToOverlap;
\import L.Maps[B := A].Over[target := source, targetSubset := subset] \as LeftIntoWhole;
\import R.Maps[B := A].Over[target := source, targetSubset := subset] \as RightIntoWhole;
\import O.Maps[B := Left].Over[target := leftTopology, targetSubset := leftPart] \as IntoLeft;
\import O.Maps[B := Right].Over[target := rightTopology, targetSubset := rightPart] \as IntoRight;
\definition leftContinuous: _ := (LeftIntoWhole.laws Geometry.leftPairMap).continuous;
\definition rightContinuous: _ := (RightIntoWhole.laws Geometry.rightPairMap).continuous;
\definition overlapLeftContinuous: _ := (IntoLeft.laws Geometry.toLeft).continuous;
\definition overlapRightContinuous: _ := (IntoRight.laws Geometry.toRight).continuous;
\import \root.PairMap[A := Overlap, B := Left, source := overlapTopology, target := leftTopology, part := overlapPart, boundary := leftPart, f := Geometry.toLeft, K := K, ring := ring] \as LeftPull;
\import \root.PairMap[A := Overlap, B := Right, source := overlapTopology, target := rightTopology, part := overlapPart, boundary := rightPart, f := Geometry.toRight, K := K, ring := ring] \as RightPull;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as IntegerCochains;
\import chain_complexes.Cochain[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as OrdinaryCochains;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := K, ring := ring].With[coefficients := WholeProduct.coefficients] \as WholeOrdinary;
\import singular_cohomology.Cochains[A := Left, source := leftTopology].OverRing[R := K, ring := ring].With[coefficients := WholeProduct.coefficients] \as LeftOrdinary;
\import singular_cohomology.Cochains[A := Right, source := rightTopology].OverRing[R := K, ring := ring].With[coefficients := WholeProduct.coefficients] \as RightOrdinary;
\import singular_cohomology.Cochains[A := Overlap, source := overlapTopology].OverRing[R := K, ring := ring].With[coefficients := WholeProduct.coefficients] \as OverlapOrdinary;
\import W.With[coefficients := WholeProduct.integerCoefficients] \as WholeRelative;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := Cover.openCover].Subspace[subset := subset].Relative[].With[coefficients := WholeProduct.integerCoefficients] \as WholeComparison;
\module Restriction(q: N.Nat^);
\module Cup(p, q: N.Nat^);
\module Positive(p, q: N.Nat^);
\module Connecting(p, q: N.Nat^);
