\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import N.Order[].Prop[] \as Order;
\import std.Data[].FinSet[] \as Finite;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Modules;
\definition Index: \Set := Finite.Fin count;
\definition bound: Lists.List[Index] -> N.Nat^ :=
  \induction (xs: Lists.List[Index]) \return N.Nat^ \with {
    | nil: N.Nat^::zero
    | cons: \fun (i: Index)(xs: Lists.List[Index])(r: N.Nat^) => Order.commonBound (N.Nat^::succ (degree i)) r
  };
\definition occursBound: \forall (xs: Lists.List[Index])(i: Index) -> Finite.Occurs count i xs -> Nat.Le (N.Nat^::succ (degree i)) (bound xs) :=
  \induction (xs: Lists.List[Index]) \return \forall (i: Index) -> Finite.Occurs count i xs -> Nat.Le (N.Nat^::succ (degree i)) (bound xs) \with {
    | nil: \fun (i: Index)(bad: Logic.False) => Logic.falseElim _ bad
    | cons: \fun (j: Index)(xs: Lists.List[Index])(prior: \forall (i: Index) -> Finite.Occurs count i xs -> Nat.Le (N.Nat^::succ (degree i)) (bound xs))
      (i: Index)(member: Finite.Occurs count i (Lists.List[Index]::cons j xs)) =>
        either!{member {Nat.Le (N.Nat^::succ (degree i)) (bound (Lists.List[Index]::cons j xs))}
          {\fun (same: i = j) => \idelim j = i \with k: Index => Nat.Le (N.Nat^::succ (degree k)) (bound (Lists.List[Index]::cons j xs))
            \by { base: Order.leftLeCommonBound (N.Nat^::succ (degree j)) (bound xs), equality: sym!{Index} _ _ same }}
          {\fun (tail: Finite.Occurs count i xs) => Nat.leTrans (N.Nat^::succ (degree i)) (bound xs) (bound (Lists.List[Index]::cons j xs))
            (prior i tail) (Order.rightLeCommonBound (N.Nat^::succ (degree j)) (bound xs))}
        }
  };
\definition top: N.Nat^ := bound (Finite.elements count);
\definition degreeBelow: \forall (i: Index) -> Nat.Lt (degree i) top :=
  \fun (i: Index) => Nat.ltOfSuccLe top (degree i) (occursBound (Finite.elements count) i (Finite.exhaustive count i));
\module On(family: Modules.Family[Finite.Fin count]) {
  \import Modules.Product[Index := Finite.Fin count, family := family] \as Product;
  \import Modules.Hom[V := Product.Carrier, W := Product.Carrier, source := Product.space, target := Product.space] \as Hom;
  \module With(t: Hom.Map);
  \import Modules.Isomorphism[V := Product.Carrier, W := Product.Carrier, source := Product.space, target := Product.space] \as Iso;
  \module Comparison(actual: Hom.Map, diagonal: Iso.Isomorphism);
}
