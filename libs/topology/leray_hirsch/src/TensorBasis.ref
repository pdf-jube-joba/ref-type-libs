\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Arithmetic;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Data[].FinSet[] \as Finite;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\definition baseRing: std.Alg[].Ring[].Ring[K] := std.Alg[].Ring[].commutativeRingAsRing K ring;
\import module_theory.Module[].Over[R := K, ring := baseRing] \as Modules;
\import chain_complexes.Cochain[].Over[R := K, ring := baseRing] \as Native;
\import chain_complexes.Integer[].Over[R := K, ring := baseRing] \as Signed;
\import \root.DegreeShift[] \as Degree;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := K, space := Modules.scalarModule };
\import resolutions.HomComplex[].Over[R := K, ring := ring].Abelian[N := coefficients] \as Hom;
\use std.Logic[].Equality[].trans;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\module Of(P, Q: Chains.Complex) {
  \import Hom.Native[P := P] \as Base;
  \import Hom.Native[P := Q] \as Fiber;
  \import Double.Tensor[C := P, D := Q] \as Tensor;
  \import Double.Total[C := Tensor.complex] \as Total;
  \import Hom.Native[P := Total.complex] \as Product;
  \import Native.ZeroExtension[C := Base.complex] \as Input;
  \import Native.ZeroExtension[C := Product.complex] \as Output;
  \definition source[z: I.Int^]: Modules.Bundle := Modules.Bundle {
    Carrier := Signed.At[C := Input.complex, z := z].Cohomology, space := Signed.At[C := Input.complex, z := z].cohomologySpace,
  };
  \definition target[z: I.Int^]: Modules.Bundle := Modules.Bundle {
    Carrier := Signed.At[C := Output.complex, z := z].Cohomology, space := Signed.At[C := Output.complex, z := z].cohomologySpace,
  };
  \definition targetFamily: Modules.Family[I.Int^] := Modules.Family[I.Int^] {
    Carrier := \fun (z: I.Int^) => (target z).Carrier, space := \fun (z: I.Int^) => (target z).space,
  };
  \import \root.Transport[K := K, ring := ring].For[Index := I.Int^, family := targetFamily] \as Regrade;
  \import \root.TensorCochainCup[K := K, ring := ring].Of[C := P, D := Q] \as Pairing;
  \module Fixed(q: N.Nat^, beta: Fiber.Carrier q, closed: Fiber.apply q beta = (Fiber.space (N.Nat^::succ q)).zero);
  \module FiniteBasis(count: N.Nat^, degrees: Finite.Fin count -> N.Nat^,
    cycles: \forall (i: Finite.Fin count) -> Fiber.Carrier (degrees i),
    closed: \forall (i: Finite.Fin count) -> Fiber.apply (degrees i) (cycles i) = (Fiber.space (N.Nat^::succ (degrees i))).zero);
  \module ZeroLeft(zeroLeft: \forall (n: N.Nat^)(x: P.family.Carrier n) -> x = (P.family.space n).zero);
  \module Along(B: Chains.Complex, f: Chains.Map[C := B, D := P].Map);
}
