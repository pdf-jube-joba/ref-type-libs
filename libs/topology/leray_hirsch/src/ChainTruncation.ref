\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\module Of(C: Chains.Complex, kept: N.Nat^ -> \Prop,
  downward: \forall (n: N.Nat^) -> kept (N.Nat^::succ n) -> kept n);

\module Layer(C: Chains.Complex, cutoff: N.Nat^);

\module Comparison(C, D: Chains.Complex, K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
