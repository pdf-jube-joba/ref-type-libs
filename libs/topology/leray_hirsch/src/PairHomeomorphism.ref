\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import std.Logic[].Proposition[] \as Logic;
\import singular_cohomology.Relative[A := A, source := source, subset := part] \as Source;
\import singular_cohomology.Relative[A := B, source := target, subset := boundary] \as Target;
\import Source.Homeomorphism[B := B].Over[target := target, targetSubset := boundary] \as Pairs;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Product;
\import \root.PairMap[A := A, B := B, source := source, target := target, part := part, boundary := boundary,
  f := Pairs.forwardMap data, K := K, ring := ring] \as Pull;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Modules;
\import Source.OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as Result;
\import Target.OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as Input;
\module At(z: I.Int^) {
  \definition domain: Modules.Bundle := Modules.Bundle { Carrier := Input.At[z := z].Carrier, space := Input.At[z := z].space };
  \definition range: Modules.Bundle := Modules.Bundle { Carrier := Result.At[z := z].Carrier, space := Result.At[z := z].space };
  \definition linear: Modules.MapBetween domain range := Pull.At[z := z].linear;
  \definition integerIso: _ := Pairs.With[coefficients := Product.integerCoefficients].At[z := z].isomorphism data;
  \import Modules.Isomorphism[V := domain.Carrier, W := range.Carrier, source := domain.space, target := range.space].OfBijective[f := linear] \as Iso;
  \definition injective: Iso.Injective := \fun (x, y: domain.Carrier)(same: linear.apply x = linear.apply y) =>
    trans!{{domain.Carrier}} _ _ _
      (sym!{{domain.Carrier}} _ _ (integerIso.leftInverse x))
      (trans!{{domain.Carrier}} _ _ _ (congr!{{range.Carrier} {domain.Carrier}} integerIso.backward.apply _ _ same)
        (integerIso.leftInverse y));
  \definition onto: Iso.Onto := \fun (y: range.Carrier) =>
    Logic.existsIntro[domain.Carrier, { x: domain.Carrier \where linear.apply x = y }] (integerIso.backward.apply y)
      (integerIso.rightInverse y);
  \definition isomorphism: _ := Iso.isomorphism injective onto;
}
