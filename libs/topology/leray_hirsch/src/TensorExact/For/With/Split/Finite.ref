\import std.Data[].FinSet[] \as Finite;
\import chain_complexes.Integer[] \as Degrees;
\import Degrees.Over[R := K, ring := baseRing] \as Signed;
\import \root.DegreeShift[] \as Degree;
\import Hom.Native[P := A] \as HA;
\import Hom.Native[P := B] \as HB;
\import Hom.Native[P := C] \as HC;
\import Hom.Native[P := LeftTotal.complex] \as TA;
\import Hom.Native[P := MiddleTotal.complex] \as TB;
\import Hom.Native[P := RightTotal.complex] \as TC;
\import Cochains.ZeroExtension[C := HA.complex] \as BaseA;
\import Cochains.ZeroExtension[C := HB.complex] \as BaseB;
\import Cochains.ZeroExtension[C := HC.complex] \as BaseC;
\import Cochains.ZeroExtension[C := TA.complex] \as TensorA;
\import Cochains.ZeroExtension[C := TB.complex] \as TensorB;
\import Cochains.ZeroExtension[C := TC.complex] \as TensorC;
\import Cochains.ShortExact[A := HC.complex, B := HB.complex, C := HA.complex].With[s := baseSequence] \as Base;
\import Cochains.ShortExact[A := TC.complex, B := TB.complex, C := TA.complex].With[s := tensorSequence] \as Tensor;
\import \root.CohomologyExact[K := K, ring := baseRing].Between[A := BaseC.complex, B := BaseB.complex, C := BaseA.complex] \as BaseRows;
\import \root.CohomologyExact[K := K, ring := baseRing].Between[A := TensorC.complex, B := TensorB.complex, C := TensorA.complex] \as TensorRows;
\import \root.TensorBasis[K := K, ring := ring].Of[P := A, Q := D] \as OnA;
\import \root.TensorBasis[K := K, ring := ring].Of[P := B, Q := D] \as OnB;
\import \root.TensorBasis[K := K, ring := ring].Of[P := C, Q := D] \as OnC;
\import OnC.Along[B := B, f := s.projection] \as AlongProjection;
\import OnB.Along[B := A, f := s.inclusion] \as AlongInclusion;
\definition Index: \Set := Finite.Fin count;
\import \root.ProductExact[K := K, ring := ring, Index := Index] \as Direct;
\module At(z: I.Int^);

\module InductionStep;
