\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason_in;
\import module_theory.Module[].Over[R := K, ring := ring] \as Modules;
\module On(V: \Set, space: Modules.Space V) {
  \import Modules.End[V := V, space := space] \as Identity;
  \import Modules.Hom[V := V, W := V, source := space, target := space] \as Maps;
  \module With(t: Maps.Map);
}
